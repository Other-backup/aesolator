<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/surface_runtime_prefixpack_background"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:background="@drawable/surface_runtime_prefixpack_background"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="7dp"
        android:paddingBottom="6dp"
        android:tag="preserve_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_runtime_prefixpack_header_background"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="@string/prefix_pack_diagnostics_title"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="8.7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVPrefixPackDiagnosticsIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/prefix_pack_diagnostics_intro"
            android:textColor="@color/surface_runtime_prefixpack_muted"
            android:textSize="7.8sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/surface_runtime_prefixpack_header_background"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="@string/prefix_pack_diagnostics_flow_title"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="8.3sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/prefix_pack_diagnostics_flow_summary"
            android:textColor="@color/surface_runtime_prefixpack_muted"
            android:textSize="7.8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/surface_runtime_prefixpack_background"
            android:orientation="vertical"
            android:padding="6dp"
            android:tag="preserve_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_prefixpack_header_background"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/prefix_pack_diagnostics_directx"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textSize="8.6sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/BTOpenDxDiag"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_dxdiag"
                    android:textSize="8.1sp" />

                <Button
                    android:id="@+id/BTOpenDxCaps"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_dxcaps"
                    android:textSize="8.1sp" />

                <Button
                    android:id="@+id/BTOpenDxCpl"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_dxcpl"
                    android:textSize="8.1sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/surface_runtime_prefixpack_background"
            android:orientation="vertical"
            android:padding="6dp"
            android:tag="preserve_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_prefixpack_header_background"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/prefix_pack_diagnostics_render"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textSize="8.6sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/BTOpenTestD3D"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_testd3d"
                    android:textSize="8.1sp" />

                <Button
                    android:id="@+id/BTOpenGpuInfo"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_gpuinfo"
                    android:textSize="8.1sp" />

                <Button
                    android:id="@+id/BTOpenGlView"
                    style="@style/ButtonInlineRuntimeNeutral"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="@string/prefix_pack_open_glview"
                    android:textSize="8.1sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/surface_runtime_prefixpack_background"
            android:orientation="vertical"
            android:padding="6dp"
            android:tag="preserve_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_prefixpack_header_background"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/prefix_pack_diagnostics_runtime"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textSize="8.6sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/BTOpenWineCfg"
                style="@style/ButtonInlineRuntimeNeutral"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:minHeight="0dp"
                android:text="@string/prefix_pack_open_winecfg"
                android:textSize="8.1sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
