+    private String getRemoteDownloadKey(ContentProfile profile) {
+        String entryName = ContentsManager.getEntryName(profile);
+        if (entryName == null || entryName.trim().isEmpty()) {
+            entryName = (profile.type != null ? profile.type.name() : "content") + "-" + profile.verCode;
+        }
+        return entryName.toLowerCase(Locale.US);
