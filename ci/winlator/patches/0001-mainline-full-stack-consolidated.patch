+            obj.put("linuxState", describeLinuxState(row.processSample.state));
+            obj.put("cpuPercent", row.processSample.cpuPercent);
+            obj.put("residentBytes", row.processSample.residentBytes);
+            obj.put("virtualBytes", row.processSample.virtualBytes);
+            obj.put("threads", row.processSample.threadCount);
+            obj.put("fileDescriptors", row.processSample.fileDescriptorCount);
+            obj.put("cpuSet", row.processSample.cpuSetList);
+            obj.put("priority", row.processSample.priority);
+            obj.put("nice", row.processSample.nice);
+            obj.put("lastCpu", row.processSample.lastCpu);
+            obj.put("schedulingPolicy", describeSchedulingPolicy(row.processSample.schedulingPolicy));
+            obj.put("ageMs", row.processSample.ageMs);
+            obj.put("waitChannel", row.processSample.waitChannel);
+            obj.put("oomScore", row.processSample.oomScore);
+            obj.put("readBytes", row.processSample.readBytes);
+            obj.put("writeBytes", row.processSample.writeBytes);
+            obj.put("readRateBytes", row.processSample.readRateBytes);
+            obj.put("writeRateBytes", row.processSample.writeRateBytes);
+            obj.put("contextSwitchRate", row.processSample.contextSwitchesPerSecond);
+            obj.put("contextSwitchTotal", row.processSample.totalContextSwitches);
+            obj.put("swapBytes", row.processSample.swapBytes);
+            obj.put("rssAnonBytes", row.processSample.rssAnonBytes);
+            obj.put("rssFileBytes", row.processSample.rssFileBytes);
+            obj.put("rssShmemBytes", row.processSample.rssShmemBytes);
+            JSONObject sockets = new JSONObject();
+            sockets.put("tcp", row.processSample.tcpSocketCount);
+            sockets.put("udp", row.processSample.udpSocketCount);
+            sockets.put("inet", row.processSample.inetSocketCount);
