+
+#include "vulkan/vulkan_core.h"
+
+struct vk_device_extension_table;
+
+bool panvk_aemali_policy_enabled(void);
+const char *panvk_aemali_policy_profile(void);
+uint32_t panvk_aemali_clamp_instance_version(uint32_t version);
+void panvk_aemali_filter_device_extensions(struct vk_device_extension_table *ext,
