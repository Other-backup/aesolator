+    private void showForensicCenterDialog() {
+        ForensicConfig.Snapshot snapshot = ForensicConfig.load(this);
+        String runtimeSummary = ForensicConfig.buildRuntimeSummary(snapshot);
+        String captureSummary = ForensicConfig.buildCaptureSummary(this, snapshot);
+        String captureCmd = ForensicConfig.buildCaptureCommand(this, snapshot);
+        String browseCmd = ForensicConfig.buildIssueBrowseCommand(this);
+
+        String message = getString(R.string.diagnostics_hint)
+                + "\n\n"
+                + getString(R.string.diagnostics_contract_summary, runtimeSummary, snapshot.wineDebugChannels)
+                + "\n\n"
+                + getString(R.string.diagnostics_capture_summary, captureSummary, "run-as")
+                + "\n\n"
+                + getString(R.string.diagnostics_adb_command_prefix) + captureCmd
+                + "\n"
+                + getString(R.string.diagnostics_adb_browse_command_prefix) + browseCmd;
+
+        new AlertDialog.Builder(this)
+                .setTitle(R.string.diagnostics)
+                .setMessage(message)
+                .setPositiveButton("Copy ADB Capture", (dialog, which) ->
+                        copyToClipboard("forensic-adb-capture", captureCmd, R.string.diagnostics_adb_command_copied))
+                .setNegativeButton("Copy ADB Browse", (dialog, which) ->
+                        copyToClipboard("forensic-adb-browse", browseCmd, R.string.diagnostics_adb_browse_command_copied))
+                .setNeutralButton("Open Settings", (dialog, which) -> {
+                    currentMenuItemId = R.id.main_menu_settings;
+                    show(new SettingsFragment(), false);
+                })
+                .show();
+    }
+
+    private void copyToClipboard(String label, String text, int toastResId) {
+        ClipboardManager clipboardManager = (ClipboardManager) getSystemService(CLIPBOARD_SERVICE);
+        if (clipboardManager == null) return;
+        clipboardManager.setPrimaryClip(ClipData.newPlainText(label, text));
+        AppUtils.showToast(this, toastResId);
+    }
 
