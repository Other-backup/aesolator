<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="96dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/SProfile"
                        style="@style/ComboBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:spinnerMode="dialog" />

                    <ImageButton
                        android:id="@+id/BTAddProfile"
                        style="@style/ListMenuButton"
                        android:contentDescription="@string/add"
                        android:src="@drawable/icon_add"
                        android:tooltipText="@string/add" />

                    <ImageButton
                        android:id="@+id/BTEditProfile"
                        style="@style/ListMenuButton"
                        android:contentDescription="@string/edit"
                        android:src="@drawable/icon_edit"
                        android:tooltipText="@string/edit" />

                    <ImageButton
                        android:id="@+id/BTDuplicateProfile"
                        style="@style/ListMenuButton"
                        android:contentDescription="@string/duplicate"
                        android:src="@drawable/icon_duplicate"
                        android:tooltipText="@string/duplicate" />

                    <ImageButton
                        android:id="@+id/BTRemoveProfile"
                        style="@style/ListMenuButton"
                        android:contentDescription="@string/remove"
                        android:layout_marginEnd="0dp"
                        android:src="@drawable/icon_remove"
                        android:tooltipText="@string/remove" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/overlay_opacity" />

                    <TextView
                        android:id="@+id/TVUiOpacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/SBOverlayOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:min="10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/BTImportProfile"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/import_profile" />

                    <Button
                        android:id="@+id/BTExportProfile"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/export_profile" />
                </LinearLayout>

                <Button
                    android:id="@+id/BTControlsEditor"
                    style="@style/ButtonPositive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/controls_editor" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/profile" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <CheckBox
                    android:id="@+id/CBGyroEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_right_stick_gyro" />

                <TextView
                    android:id="@+id/TVGyroTriggerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/gyro_activator_button" />

                <Spinner
                    android:id="@+id/SBGyroTriggerButton"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/button_options" />

                <RadioGroup
                    android:id="@+id/RGyroMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/RBHoldMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="@string/hold_mode" />

                    <RadioButton
                        android:id="@+id/RBToggleMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/toggle_mode" />
                </RadioGroup>

                <Button
                    android:id="@+id/BTConfigureGyro"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/calibrate_gyroscope" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/gyro_section_title" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trigger_type" />

                    <ImageView
                        android:id="@+id/BTHelpTriggerMode"
                        style="@style/HelpButton"
                        android:layout_gravity="center" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/RGTriggerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/RBTriggerIsButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/as_button" />

                    <RadioButton
                        android:id="@+id/RBTriggerIsAxis"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/as_axis" />

                    <RadioButton
                        android:id="@+id/RBTriggerIsMixed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mixed"
                        android:visibility="gone" />
                </RadioGroup>

                <Button
                    android:id="@+id/BTConfigureAnalogSticks"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/configure_analog_sticks_title" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/trigger_section_title" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <LinearLayout
                    android:id="@+id/LLExternalControllers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/external_controllers" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
