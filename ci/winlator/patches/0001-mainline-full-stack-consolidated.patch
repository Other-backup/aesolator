+    }
+
+    @Nullable
+    private static Window resolveRenderOwnerWindow(@Nullable Window trackedWindow) {
+        Window bestWindow = trackedWindow;
+        int bestScore = Integer.MIN_VALUE;
+        Window cursor = trackedWindow;
+        int depth = 0;
+        while (cursor != null && depth < 12) {
+            int score = 0;
+            if (cursor.isApplicationWindow()) score += 50;
+            if (cursor.attributes.isMapped()) score += 20;
+            if (cursor.getProcessId() > 0) score += 30;
+            if (cursor.getHandle() != 0L) score += 15;
+            if (!TextUtils.isEmpty(sanitizeTrackedWindowText(cursor.getName()))) score += 10;
+            if (!TextUtils.isEmpty(sanitizeTrackedWindowText(cursor.getClassName()))) score += 8;
+            if (score >= bestScore) {
+                bestScore = score;
+                bestWindow = cursor;
+            }
+            cursor = cursor.getParent();
+            depth++;
+        }
+        return bestWindow;
+    }
+
+    private static String sanitizeTrackedWindowText(@Nullable String value) {
+        if (TextUtils.isEmpty(value)) {
+            return "";
+        }
+        return value.replace('\0', ' ').replaceAll("\\s+", " ").trim();
+    }
