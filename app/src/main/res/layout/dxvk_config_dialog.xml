<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vkd3d_version" />

                <Spinner
                    android:id="@+id/SVKD3DVersion"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:entries="@array/vkd3d_version_entries"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vkd3d_feature_level" />

                <Spinner
                    android:id="@+id/SVKD3DFeatureLevel"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dxvk_version" />

                <Spinner
                    android:id="@+id/SDXVKVersion"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:entries="@array/dxvk_version_entries"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/frame_rate" />

                <Spinner
                    android:id="@+id/SFramerate"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:entries="@array/dxvk_framerate_entries"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/dxvk_vkd3d_configuration" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <LinearLayout
                    android:id="@+id/LLAsync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:text="@string/enabled_async" />

                    <ToggleButton
                        android:id="@+id/SWAsync"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:background="@drawable/toggle_button_selector"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLAsyncCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:text="@string/enabled_async_cache" />

                    <ToggleButton
                        android:id="@+id/SWAsyncCache"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:background="@drawable/toggle_button_selector"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/advanced" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
