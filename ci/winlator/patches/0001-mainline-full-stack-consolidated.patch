+    private boolean matchesRenderTarget(WindowSnapshot windowSnapshot,
+                                        LinuxTelemetrySampler.ProcessSample processSample,
+                                        XServerDisplayActivity.RenderTelemetrySnapshot renderTelemetry) {
+        if (windowSnapshot == null) {
+            return false;
+        }
+        if (windowSnapshot.containsTrackedFrameWindow) {
+            return true;
+        }
+        if (renderTelemetry.trackedWindowPid > 0 && processSample != null && processSample.pid == renderTelemetry.trackedWindowPid) {
+            return true;
+        }
+        if (renderTelemetry.trackedWindowHandle != 0L && windowSnapshot.handle == renderTelemetry.trackedWindowHandle) {
+            return true;
+        }
+        return !TextUtils.isEmpty(renderTelemetry.trackedWindowTitle)
+                && !TextUtils.isEmpty(renderTelemetry.trackedWindowClassName)
+                && TextUtils.equals(windowSnapshot.windowTitle, renderTelemetry.trackedWindowTitle)
+                && TextUtils.equals(windowSnapshot.className, renderTelemetry.trackedWindowClassName);
+    }
