+    private void decorateProcessTree(ArrayList<TaskRow> rows) {
+        android.util.SparseArray<TaskRow> rowByPid = new android.util.SparseArray<>();
+        android.util.SparseIntArray childCounts = new android.util.SparseIntArray();
+        for (TaskRow row : rows) {
+            rowByPid.put(row.pid, row);
+        }
+        for (TaskRow row : rows) {
+            int parentPid = row.processSample != null ? row.processSample.parentPid : 0;
+            if (parentPid > 0 && rowByPid.get(parentPid) != null && parentPid != row.pid) {
+                childCounts.put(parentPid, childCounts.get(parentPid) + 1);
+            }
+        }
+        for (TaskRow row : rows) {
+            row.rootPid = resolveRootPid(row, rowByPid);
+            row.treeDepth = computeTreeDepth(row, rowByPid);
+            row.childCount = childCounts.get(row.pid);
+            row.treeLabel = buildTreeLabel(row.displayName, row.treeDepth);
+            row.hierarchyMetrics = buildHierarchyMetric(row);
+        }
+
+        android.util.SparseArray<TreeGroupStats> groupStats = buildTreeGroupStats(rows);
+        Collections.sort(rows, Comparator
+                .comparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).hasFocusedDescendant).reversed()
+                .thenComparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).hasRenderDescendant).reversed()
+                .thenComparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).maxVisibleWindows).reversed()
+                .thenComparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).maxCpuPercent).reversed()
+                .thenComparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).totalResidentBytes).reversed()
+                .thenComparing((TaskRow row) -> getTreeGroupStats(groupStats, row.rootPid).rootLabel.toLowerCase(Locale.ROOT))
+                .thenComparingInt((TaskRow row) -> row.rootPid)
+                .thenComparingInt((TaskRow row) -> row.treeDepth)
+                .thenComparing(TaskRow::isRenderTarget).reversed()
+                .thenComparing(TaskRow::isFocused).reversed()
+                .thenComparing(TaskRow::getVisibleWindowCount).reversed()
+                .thenComparing(TaskRow::getCpuPercent).reversed()
+                .thenComparing((TaskRow row) -> row.displayName.toLowerCase(Locale.ROOT))
+                .thenComparingInt((TaskRow row) -> row.pid));
+    }
