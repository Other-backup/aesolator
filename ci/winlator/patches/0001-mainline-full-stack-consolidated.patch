+    private void renderSnapshot() {
+        XServerDisplayActivity.RenderTelemetrySnapshot renderTelemetry = activity.getRenderTelemetrySnapshot();
+        latestHostSample = telemetrySampler.sampleHost(activity);
+        android.util.SparseArray<WindowSnapshot> windows = collectWindowSnapshots(renderTelemetry.trackedWindowId);
+        ArrayList<TaskRow> rows = buildRows(windows, renderTelemetry);
+        ArrayList<TaskRow> scopedRows = applyProcessScope(rows);
+        ArrayList<TaskRow> visibleRows = applySocketFilter(scopedRows);
+        updateSummaryViews(latestHostSample, renderTelemetry, visibleRows);
+        updateProcessList(visibleRows);
+    }
+
+    private ArrayList<TaskRow> buildRows(android.util.SparseArray<WindowSnapshot> windows,
+                                         XServerDisplayActivity.RenderTelemetrySnapshot renderTelemetry) {
+        Set<Integer> livePids = new HashSet<>();
+        for (int i = 0; i < latestProcessMap.size(); i++) {
+            livePids.add(latestProcessMap.keyAt(i));
+        }
+        for (int i = 0; i < windows.size(); i++) {
+            livePids.add(windows.keyAt(i));
+        }
+        for (Integer pid : ProcessHelper.listRuntimeProcessIds()) {
+            livePids.add(pid);
+        }
+
+        ArrayList<TaskRow> rows = new ArrayList<>(livePids.size());
+        for (Integer pid : livePids) {
+            ProcessInfo processInfo = latestProcessMap.get(pid);
+            WindowSnapshot windowSnapshot = windows.get(pid);
+            LinuxTelemetrySampler.ProcessSample processSample = telemetrySampler.sampleProcess(pid);
+            if (processInfo == null && windowSnapshot == null && processSample == null) {
+                continue;
+            }
+            rows.add(buildTaskRow(pid, processInfo, processSample, windowSnapshot, renderTelemetry));
+        }
+        telemetrySampler.retainOnly(livePids);
+        decorateProcessTree(rows);
+
+        return rows;
+    }
+
+    private ArrayList<TaskRow> applyProcessScope(ArrayList<TaskRow> rows) {
+        if (currentProcessScope == ProcessScope.ALL) {
+            return rows;
+        }
+
+        ArrayList<TaskRow> filteredRows = new ArrayList<>();
+        for (TaskRow row : rows) {
+            if (matchesProcessScope(row)) {
+                filteredRows.add(row);
+            }
+        }
+        return filteredRows;
+    }
+
+    private boolean matchesProcessScope(TaskRow row) {
+        switch (currentProcessScope) {
+            case WINDOWS:
+                return row.windowSnapshot != null;
+            case GUEST:
+                return row.processInfo != null || row.windowSnapshot != null;
+            case HOST:
+                return row.processSample != null;
+            case ALL:
+            default:
+                return true;
+        }
+    }
+
+    private ArrayList<TaskRow> applySocketFilter(ArrayList<TaskRow> rows) {
+        if (currentSocketFilter == SocketFilter.ALL) {
+            return rows;
+        }
+
+        android.util.SparseArray<TaskRow> rowByPid = new android.util.SparseArray<>();
+        HashSet<Integer> includedPids = new HashSet<>();
+        for (TaskRow row : rows) {
+            rowByPid.put(row.pid, row);
+        }
+        for (TaskRow row : rows) {
+            if (matchesSocketFilter(row)) {
+                includeRowAncestors(row, rowByPid, includedPids);
+            }
+        }
+
+        ArrayList<TaskRow> filteredRows = new ArrayList<>();
+        for (TaskRow row : rows) {
+            if (includedPids.contains(row.pid)) {
+                filteredRows.add(row);
+            }
+        }
+        return filteredRows;
+    }
+
+    private static void includeRowAncestors(TaskRow row, android.util.SparseArray<TaskRow> rowByPid, Set<Integer> includedPids) {
+        TaskRow cursor = row;
+        int depth = 0;
+        while (cursor != null && depth < 16) {
+            if (!includedPids.add(cursor.pid)) {
+                break;
+            }
+            int parentPid = cursor.processSample != null ? cursor.processSample.parentPid : 0;
+            cursor = parentPid > 0 ? rowByPid.get(parentPid) : null;
+            depth++;
+        }
+    }
+
+    private boolean matchesSocketFilter(TaskRow row) {
+        if (row.processSample == null) {
+            return false;
+        }
+        switch (currentSocketFilter) {
+            case ANY:
+                return row.processSample.hasSocketTelemetry();
+            case TCP:
+                return row.processSample.hasTcpSockets();
+            case UDP:
+                return row.processSample.hasUdpSockets();
+            case UNIX:
+                return row.processSample.hasUnixSockets();
+            case ALL:
+            default:
+                return true;
+        }
+    }
+
+    private TaskRow buildTaskRow(int pid, ProcessInfo processInfo, LinuxTelemetrySampler.ProcessSample processSample,
+                                 WindowSnapshot windowSnapshot,
+                                 XServerDisplayActivity.RenderTelemetrySnapshot renderTelemetry) {
+        boolean renderTarget = matchesRenderTarget(windowSnapshot, processSample, renderTelemetry);
+        String processLabel = processInfo != null
+                ? processInfo.name + (processInfo.wow64Process ? " *32" : "")
+                : processSample != null ? processSample.commandName : "PID " + pid;
+        String title = firstNonEmpty(windowSnapshot != null ? windowSnapshot.windowTitle : null, processLabel, "PID " + pid);
+        String subtitle = joinSegments(" | ",
+                !TextUtils.equals(title, processLabel) ? processLabel : null,
+                windowSnapshot != null ? windowSnapshot.className : null,
+                processSample != null ? buildCommandLineSnippet(processSample.commandLine, processLabel, title) : null);
+        String primaryMetrics = joinSegments(" | ",
+                "PID " + pid,
+                processSample != null ? "CPU " + formatPercent(processSample.cpuPercent) : null,
+                renderTarget && renderTelemetry.fpsVisible ? formatFps(renderTelemetry.fps) : null,
+                processInfo != null && processInfo.memoryUsage > 0 ? "Guest " + StringUtils.formatBytes(processInfo.memoryUsage) : null,
+                processSample != null && processSample.residentBytes > 0 ? "RSS " + StringUtils.formatBytes(processSample.residentBytes) : null);
+        String secondaryMetrics = joinSegments(" | ",
+                processSample != null && processSample.threadCount > 0 ? "THR " + processSample.threadCount : null,
+                processSample != null && processSample.fileDescriptorCount >= 0 ? "FD " + processSample.fileDescriptorCount : null,
+                processSample != null && processSample.virtualBytes > 0 ? "VIRT " + StringUtils.formatBytes(processSample.virtualBytes) : null,
+                processSample != null && processSample.parentPid > 0 ? "PPID " + processSample.parentPid : null,
+                processSample != null && processSample.lastCpu >= 0 ? "CPU#" + processSample.lastCpu : null,
+                processSample != null && !TextUtils.isEmpty(processSample.cpuSetList) ? "CPUSET " + processSample.cpuSetList : null,
+                processSample != null && processSample.ageMs > 0 ? "AGE " + formatDuration(processSample.ageMs) : null);
+        String tertiaryMetrics = joinSegments(" | ",
+                renderTarget ? buildRenderMetric(renderTelemetry) : null,
+                processSample != null && processSample.hasIoRate() ? "IO/s " + formatIo(processSample.readRateBytes, processSample.writeRateBytes) : null,
+                processSample != null && processSample.hasContextSwitchRate() ? "CTX/s " + formatSwitchRate(processSample.contextSwitchesPerSecond) : null,
+                processSample != null && processSample.hasIoStats() ? "IO " + formatIo(processSample.readBytes, processSample.writeBytes) : null,
+                processSample != null && processSample.swapBytes > 0L ? "SWAP " + StringUtils.formatBytes(processSample.swapBytes) : null,
+                windowSnapshot != null ? buildWindowMetric(windowSnapshot) : activity.getString(R.string.task_manager_state_headless));
+        String quaternaryMetrics = joinSegments(" | ",
+                buildSourceMetric(processInfo, windowSnapshot, processSample),
+                processSample != null ? buildSchedulerMetric(processSample) : null,
+                processSample != null && processSample.hasSocketTelemetry() ? buildSocketMetric(processSample) : null,
+                processSample != null && processSample.hasRssBreakdown() ? buildRssBreakdownMetric(processSample) : null,
+                processSample != null && !TextUtils.isEmpty(processSample.waitChannel) ? "WAIT " + trimMiddle(processSample.waitChannel, 28) : null,
+                processSample != null && processSample.oomScore >= 0 ? "OOM " + processSample.oomScore : null);
+        String stateLabel = resolveStateLabel(processInfo, processSample, windowSnapshot, renderTarget);
+
+        return new TaskRow(pid, title, subtitle, primaryMetrics, secondaryMetrics, tertiaryMetrics, quaternaryMetrics, stateLabel,
+                processInfo, processSample, windowSnapshot, windowSnapshot != null ? windowSnapshot.icon : null, renderTarget);
+    }
