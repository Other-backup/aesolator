<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/gyro_preview_hint"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/TVGyroXSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gyro_x_sensitivity_label" />

                <SeekBar
                    android:id="@+id/SBGyroXSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200" />

                <TextView
                    android:id="@+id/TVGyroYSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gyro_y_sensitivity_label" />

                <SeekBar
                    android:id="@+id/SBGyroYSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200" />

                <TextView
                    android:id="@+id/TVGyroSmoothing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gyro_smoothing_label" />

                <SeekBar
                    android:id="@+id/SBGyroSmoothing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/TVGyroDeadzone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gyro_deadzone_label" />

                <SeekBar
                    android:id="@+id/SBGyroDeadzone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <CheckBox
                    android:id="@+id/CBInvertGyroX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/invert_x_axis" />

                <CheckBox
                    android:id="@+id/CBInvertGyroY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/invert_y_axis" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/gyro_configuration"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/stick_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/surface_command_background_dark" />

                <Button
                    android:id="@+id/btnResetCenter"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/reset_stick_to_center" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/gyro_preview_title"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
