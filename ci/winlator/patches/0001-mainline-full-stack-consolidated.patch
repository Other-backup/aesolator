+    private ArrayList<TurnipAssetItem> loadTurnipAssetItems(boolean forceRefresh) throws Exception {
+        ArrayList<TurnipAssetItem> items = new ArrayList<>();
+        HashSet<String> seenDownloadUrls = new HashSet<>();
+        ArrayList<String> failures = new ArrayList<>();
+
+        String channelMode = getTurnipChannelMode();
+        boolean includeNightly = TURNIP_CHANNEL_MODE_ALL.equals(channelMode);
+        String sourceMode = getTurnipSourceMode();
+        int releaseLimit = getTurnipReleaseLimit();
+        int fetchedSources = 0;
+
+        for (TurnipSource source : getActiveTurnipSources()) {
+            try {
+                String json = loadTurnipReleasesJson(source, forceRefresh);
+                JSONArray releases = new JSONArray(json);
+                fetchedSources++;
+                for (int i = 0; i < releases.length(); i++) {
+                    JSONObject release = releases.getJSONObject(i);
+                    String releaseName = release.optString("name", release.optString("tag_name", "release"));
+                    String tagName = release.optString("tag_name", "");
+                    String publishedAt = release.optString("published_at", "");
+                    boolean prerelease = release.optBoolean("prerelease", false);
+                    if (!includeNightly && prerelease) continue;
+
+                    JSONArray assets = release.optJSONArray("assets");
+                    if (assets == null) continue;
+
+                    for (int j = 0; j < assets.length(); j++) {
+                        JSONObject asset = assets.getJSONObject(j);
+                        String assetName = asset.optString("name", "");
+                        String url = asset.optString("browser_download_url", "");
+                        if (assetName.isEmpty() || url.isEmpty()) continue;
+                        if (!assetName.toLowerCase(Locale.ROOT).endsWith(".zip")) continue;
+                        if (!seenDownloadUrls.add(url)) continue;
+
+                        TurnipAssetItem item = new TurnipAssetItem();
+                        item.releaseName = releaseName;
+                        item.tagName = tagName;
+                        item.assetName = assetName;
+                        item.downloadUrl = url;
+                        item.publishedAt = publishedAt;
+                        item.prerelease = prerelease;
+                        item.sourceKey = source.key;
+                        item.sourceName = source.label;
+                        item.sourceUrl = source.releasesUrl;
+                        item.integratedProvider = source.integrated;
+                        item.trustRank = source.trustRank;
+                        item.label = buildTurnipLabel(item);
+                        items.add(item);
+                    }
+                }
+
+                if (isAdded() && getContext() != null) {
+                    ForensicLogger.logEvent(getContext(), "info", "TURNIP_SOURCE_FETCHED",
+                            "", "adrenotools_turnip",
+                            "turnip source fetched",
+                            ForensicLogger.fields(
+                                    "source_key", source.key,
+                                    "source_label", source.label,
+                                    "source_integrated", source.integrated ? "1" : "0",
+                                    "source_primary", source.primary ? "1" : "0",
+                                    "source_trust_rank", source.trustRank
+                            ));
+                }
+            } catch (Exception e) {
+                failures.add(source.label);
+                if (isAdded() && getContext() != null) {
+                    ForensicLogger.logEvent(getContext(), "warn", "TURNIP_SOURCE_FAILED",
+                            "", "adrenotools_turnip",
+                            "turnip source fetch failed",
+                            ForensicLogger.fields(
+                                    "source_key", source.key,
+                                    "source_label", source.label,
+                                    "error_detail", e.getMessage() == null ? "" : e.getMessage()
+                            ));
+                }
+            }
+        }
+
+        if (items.isEmpty() && !failures.isEmpty()) {
+            throw new IllegalStateException("turnip sources unavailable: " + failures);
+        }
+
+        Collections.sort(items, (left, right) -> {
+            String leftDate = left.publishedAt == null ? "" : left.publishedAt;
+            String rightDate = right.publishedAt == null ? "" : right.publishedAt;
+            int dateCmp = rightDate.compareTo(leftDate);
+            if (dateCmp != 0) return dateCmp;
+            int trustCmp = Integer.compare(right.trustRank, left.trustRank);
+            if (trustCmp != 0) return trustCmp;
+            int sourceCmp = left.sourceName.compareToIgnoreCase(right.sourceName);
+            if (sourceCmp != 0) return sourceCmp;
+            return left.assetName.compareToIgnoreCase(right.assetName);
+        });
+
+        int limit = releaseLimit;
+        ArrayList<TurnipAssetItem> limitedItems = items;
+        if (items.size() > limit) {
+            limitedItems = new ArrayList<>(items.subList(0, limit));
+        }
+
+        if (isAdded() && getContext() != null) {
+            ForensicLogger.logEvent(getContext(), "info", "TURNIP_CATALOG_READY",
+                    "", "adrenotools_turnip",
+                    "turnip catalog prepared",
+                    ForensicLogger.fields(
+                            "source_mode", sourceMode,
+                            "channel_mode", channelMode,
+                            "source_count_ok", fetchedSources,
+                            "source_count_failed", failures.size(),
+                            "items_total", items.size(),
+                            "items_visible", limitedItems.size(),
+                            "release_limit", releaseLimit
+                    ));
+        }
+        return limitedItems;
+    }
+
+    private String loadTurnipReleasesJson(TurnipSource source, boolean forceRefresh) throws Exception {
+        String json = null;
+        File cacheFile = new File(requireContext().getCacheDir(), "turnip_releases_cache_" + source.key + ".json");
+
+        if (!forceRefresh && cacheFile.isFile()) {
+            long age = System.currentTimeMillis() - cacheFile.lastModified();
+            if (age >= 0 && age <= TURNIP_RELEASES_CACHE_TTL_MS) {
+                json = FileUtils.readString(cacheFile);
+            }
+        }
+
+        if (json == null || json.trim().isEmpty()) {
+            json = Downloader.downloadString(source.apiUrl);
+            if (json == null || json.trim().isEmpty()) {
+                throw new IllegalStateException("empty turnip releases response");
+            }
+            FileUtils.writeString(cacheFile, json);
+        }
+        return json;
+    }
+
+    private String buildTurnipLabel(TurnipAssetItem item) {
+        String channel;
+        if (item.prerelease) channel = getString(R.string.channel_nightly);
+        else channel = getString(R.string.channel_stable);
+
+        String date = item.publishedAt;
+        if (date != null && date.length() >= 10) {
+            date = date.substring(0, 10);
+        } else {
+            date = android.text.format.DateFormat.format("yyyy-MM-dd", new Date()).toString();
+        }
+
+        String releaseLabel = !item.releaseName.isEmpty() ? item.releaseName : item.tagName;
+        String lane = item.integratedProvider ? "integrated" : "mirror";
+        return "[" + item.sourceName + " • " + lane + "] " + channel + " • " + date + " • " + releaseLabel + "\n" + item.assetName;
+    }
+
+    private void downloadAndInstall(TurnipAssetItem item) {
+        if (!isAdded() || getActivity() == null) return;
+
+        DownloadProgressDialog progressDialog = new DownloadProgressDialog(getActivity());
+        progressDialog.show(R.string.downloading_file);
+
+        new Thread(() -> {
+            File out = null;
+            try {
+                if (!isAdded() || getContext() == null) return;
+                out = new File(getContext().getCacheDir(),
+                        "turnip_" + System.currentTimeMillis() + "_" + sanitizeFilename(item.assetName));
+                downloadFileWithProgress(item.downloadUrl, out, progress -> {
+                    if (!isAdded() || getActivity() == null) return;
+                    getActivity().runOnUiThread(() -> progressDialog.setProgress(progress));
+                });
+
+                String driver = adrenotoolsManager.installDriver(out);
+                if (!isAdded() || getActivity() == null) return;
+                String installedDriver = driver;
+                getActivity().runOnUiThread(() -> {
+                    progressDialog.close();
+                    if (!installedDriver.isEmpty()) {
+                        adrenotoolsManager.rememberDriverOrigin(
+                                installedDriver,
+                                item.sourceKey,
+                                item.prerelease ? "nightly" : "stable",
+                                item.sourceUrl,
+                                item.tagName,
+                                item.assetName
+                        );
+                        ForensicLogger.logEvent(getContext(), "info", "TURNIP_INSTALL_APPLIED",
+                                "", "adrenotools_turnip",
+                                "turnip driver installed",
+                                ForensicLogger.fields(
+                                        "driver_id", installedDriver,
+                                        "provider", item.sourceKey,
+                                        "channel", item.prerelease ? "nightly" : "stable",
+                                        "source_url", item.sourceUrl,
+                                        "asset_name", item.assetName,
+                                        "integrated_provider", item.integratedProvider ? "1" : "0"
+                                ));
+                        DriversAdapter adapter = (DriversAdapter) recyclerView.getAdapter();
+                        if (adapter != null) adapter.addItem(installedDriver);
+                        AppUtils.showToast(getContext(), R.string.content_installed_success);
+                    } else {
+                        ForensicLogger.logEvent(getContext(), "warn", "TURNIP_INSTALL_REJECTED",
+                                "", "adrenotools_turnip",
+                                "turnip driver install rejected or duplicate",
+                                ForensicLogger.fields(
+                                        "provider", item.sourceKey,
+                                        "asset_name", item.assetName,
+                                        "source_url", item.sourceUrl
+                                ));
+                        AppUtils.showToast(getContext(), R.string.turnip_install_failed_or_exists);
+                    }
+                });
+            } catch (Exception e) {
+                if (!isAdded() || getActivity() == null) return;
+                getActivity().runOnUiThread(() -> {
+                    progressDialog.close();
+                    ForensicLogger.logEvent(getContext(), "warn", "TURNIP_DOWNLOAD_FAILED",
+                            "", "adrenotools_turnip",
+                            "turnip download failed",
+                            ForensicLogger.fields(
+                                    "provider", item.sourceKey,
+                                    "asset_name", item.assetName,
+                                    "source_url", item.sourceUrl,
+                                    "error_detail", e.getMessage() == null ? "" : e.getMessage()
+                            ));
+                    AppUtils.showToast(getContext(), R.string.turnip_download_failed);
+                });
+            } finally {
+                if (out != null && out.exists()) {
+                    //noinspection ResultOfMethodCallIgnored
+                    out.delete();
+                }
+            }
+        }).start();
+    }
+
+    private void downloadFileWithProgress(String address, File file, ProgressCallback progressCallback) throws Exception {
+        URLConnection connection = new URL(address).openConnection();
+        connection.connect();
+        int contentLength = connection.getContentLength();
+
+        try (InputStream input = new BufferedInputStream(connection.getInputStream());
+             OutputStream output = new FileOutputStream(file)) {
+            byte[] data = new byte[8192];
+            long total = 0;
+            int count;
+            int lastProgress = -1;
+            while ((count = input.read(data)) != -1) {
+                output.write(data, 0, count);
+                total += count;
+                if (contentLength > 0) {
+                    int progress = (int) ((total * 100L) / contentLength);
+                    if (progress != lastProgress) {
+                        lastProgress = progress;
+                        progressCallback.onProgress(progress);
+                    }
+                }
+            }
+            progressCallback.onProgress(100);
+            output.flush();
+        }
+    }
+
+    private String sanitizeFilename(String name) {
+        if (name == null || name.isEmpty()) return "driver.zip";
+        return name.replaceAll("[^a-zA-Z0-9._-]", "_");
+    }
+
+    private interface ProgressCallback {
+        void onProgress(int progress);
+    }
