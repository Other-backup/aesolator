+                    trackedWindowPid = telemetryWindow.getProcessId();
+                    trackedWindowHandle = telemetryWindow.getHandle();
+                    trackedWindowTitle = sanitizeTrackedWindowText(telemetryWindow.getName());
+                    trackedWindowClassName = sanitizeTrackedWindowText(telemetryWindow.getClassName());
+                }
