+    private static String formatFps(float value) {
+        return String.format(Locale.getDefault(), "%.1f FPS", Math.max(0f, value));
+    }
+
+    private static String formatClock(long timeMs) {
+        return String.format(Locale.getDefault(), "%tT", timeMs);
+    }
+
+    private static String formatDuration(long durationMs) {
+        long totalSeconds = Math.max(0L, durationMs / 1000L);
+        long seconds = totalSeconds % 60L;
+        long minutes = (totalSeconds / 60L) % 60L;
+        long hours = (totalSeconds / 3600L) % 24L;
+        long days = totalSeconds / 86400L;
+        if (days > 0) {
+            return String.format(Locale.getDefault(), "%dd %02d:%02d:%02d", days, hours, minutes, seconds);
+        }
+        return String.format(Locale.getDefault(), "%02d:%02d:%02d", hours, minutes, seconds);
+    }
+
+    private static String formatIo(long readBytes, long writeBytes) {
+        if (readBytes < 0L && writeBytes < 0L) {
+            return "n/a";
+        }
+        String readText = readBytes >= 0L ? StringUtils.formatBytes(readBytes) : "n/a";
+        String writeText = writeBytes >= 0L ? StringUtils.formatBytes(writeBytes) : "n/a";
+        return "R " + readText + " / W " + writeText;
+    }
+
+    private static String formatRate(long bytesPerSecond) {
+        return bytesPerSecond >= 0L ? StringUtils.formatBytes(bytesPerSecond) + "/s" : "n/a";
+    }
+
+    private static String formatSwitchRate(float switchesPerSecond) {
+        return String.format(Locale.getDefault(), "%.1f/s", Math.max(0f, switchesPerSecond));
+    }
+
+    private static String formatLoadAverage(LinuxTelemetrySampler.HostSample hostSample) {
+        return String.format(Locale.getDefault(), "load %.2f %.2f %.2f",
+                hostSample.loadAverage1m, hostSample.loadAverage5m, hostSample.loadAverage15m);
+    }
+
+    private static String buildPressureMetric(String label, float someAvg10, float fullAvg10) {
+        if (someAvg10 < 0f && fullAvg10 < 0f) {
+            return null;
+        }
+        if (fullAvg10 < 0f) {
+            return String.format(Locale.getDefault(), "%s %.2f", label, Math.max(0f, someAvg10));
+        }
+        return String.format(Locale.getDefault(), "%s %.2f/%.2f", label, Math.max(0f, someAvg10), Math.max(0f, fullAvg10));
+    }
+
+    private static String buildSchedulerMetric(LinuxTelemetrySampler.ProcessSample processSample) {
+        return joinSegments(" | ",
+                "SCHED " + describeSchedulingPolicy(processSample.schedulingPolicy),
+                "PR " + processSample.priority,
+                "NI " + processSample.nice);
+    }
+
+    private static String buildSocketMetric(LinuxTelemetrySampler.ProcessSample processSample) {
+        return joinSegments(" | ",
+                "SOCK T" + processSample.tcpSocketCount + " U" + processSample.udpSocketCount + " X" + processSample.unixSocketCount,
+                !TextUtils.isEmpty(processSample.inetEndpointSummary) ? trimMiddle(processSample.inetEndpointSummary, 46) : null,
+                !TextUtils.isEmpty(processSample.unixEndpointSummary) ? trimMiddle(processSample.unixEndpointSummary, 40) : null);
