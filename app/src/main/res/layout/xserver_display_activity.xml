<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/XServerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/FLXServerDisplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/VRuntimeDrawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/surface_runtime_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/SVRuntimeDrawer"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:elevation="18dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/LLRuntimeDrawerHeaderCard"
                    style="@style/FieldSet"
                    android:tag="theme_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/TVRuntimeDrawerContainerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/TVRuntimeDrawerShortcutName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/BTCloseRuntimeDrawer"
                            style="@style/ListMenuButton"
                            android:contentDescription="@string/close"
                            android:src="@drawable/ae_icon_back" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/TVRuntimeDrawerRoute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/TVRuntimeDrawerHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/TVRuntimeDrawerHeaderBadge"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/xserver_runtime_actions_title" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/LLRuntimeDrawerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/LLRuntimeActionKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionKeyboard"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_keyboard" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionKeyboardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/keyboard"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionKeyboardSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_keyboard_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionInputControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionInputControls"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_gamepad" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionInputControlsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/input_controls"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionInputControlsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_input_controls_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionRelativeMouse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionRelativeMouse"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_magnifier" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionRelativeMouseTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_relative_mouse_movement"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionRelativeMouseSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionScreenEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionScreenEffects"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_screen_effect" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionScreenEffectsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/screen_effect"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionScreenEffectsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_screen_effects_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionFullscreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionFullscreen"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_fullscreen" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionFullscreenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_fullscreen"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionFullscreenSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionPauseResume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionPauseResume"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_pause" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionPauseResumeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionPauseResumeSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionPip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionPip"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_picture_in_picture_alt" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionPipTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pip_mode"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionPipSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_pip_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionTaskManager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionTaskManager"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_task_manager" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionTaskManagerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/task_manager"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionTaskManagerSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_task_manager_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionMagnifier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionMagnifier"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_magnifier" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionMagnifierTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/magnifier"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionMagnifierSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionLogs"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_diagnostics" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionLogsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/logs"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionLogsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLRuntimeActionExit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/surface_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:tag="theme_card">

                    <ImageView
                        android:id="@+id/IVRuntimeActionExit"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ae_icon_remove" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVRuntimeActionExitTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/exit"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVRuntimeActionExitSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/runtime_drawer_exit_summary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <EditText
        android:id="@+id/XRTextInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:autofillHints="no"
        android:inputType="textMultiLine"
        android:visibility="gone"
        tools:ignore="LabelFor" />
</FrameLayout>
