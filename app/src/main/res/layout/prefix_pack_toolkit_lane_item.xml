<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/surface_runtime_prefixpack_background"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/IVLaneIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ae_icon_package"
            android:tint="@color/surface_runtime_prefixpack_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TVLaneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textSize="10.4sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVLaneSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/surface_runtime_prefixpack_muted"
                android:textSize="7.8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TVLaneSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/TVLaneState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textSize="7.7sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/TVLaneSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTLanePrepare"
            style="@style/ButtonInlineRuntimeNeutral"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="8.4sp"
            android:text="@string/prefix_pack_fetch" />

        <Button
            android:id="@+id/BTLaneInstall"
            style="@style/ButtonInlineRuntimePositive"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="8.4sp"
            android:text="@string/prefix_pack_install" />

        <Button
            android:id="@+id/BTLaneCleanup"
            style="@style/ButtonInlineRuntimeNeutral"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="8.4sp"
            android:text="@string/prefix_pack_cleanup" />
    </LinearLayout>
</LinearLayout>
