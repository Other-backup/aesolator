<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:color="@color/surface_input_focus" android:width="2dp" />
            <solid android:color="@color/colorAccentOverlay" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:color="@color/surface_card_border" android:width="1dp" />
            <solid android:color="@color/surface_card_bg" />
        </shape>
    </item>
</selector>
