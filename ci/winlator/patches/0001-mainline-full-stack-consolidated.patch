+                || type == ContentProfile.ContentType.CONTENT_TYPE_PROTON;
+    }
+
+    private boolean isArm64EcProfile(ContentProfile profile) {
+        if (profile == null) return false;
+        String combined = ((profile.verName != null ? profile.verName : "") + " "
+                + (profile.desc != null ? profile.desc : "") + " "
+                + (profile.remoteUrl != null ? profile.remoteUrl : "") + " "
+                + (profile.releaseTag != null ? profile.releaseTag : ""))
+                .toLowerCase(Locale.US);
+        return combined.contains("arm64ec");
+    }
+
+    private boolean isArm64VulkanSdkProfile(ContentProfile profile) {
+        if (profile == null || profile.type != ContentProfile.ContentType.CONTENT_TYPE_VULKAN_SDK) return false;
+        String combined = ((profile.verName != null ? profile.verName : "") + " "
+                + (profile.desc != null ? profile.desc : "") + " "
+                + (profile.remoteUrl != null ? profile.remoteUrl : "") + " "
+                + (profile.releaseTag != null ? profile.releaseTag : ""))
+                .toLowerCase(Locale.US);
+        if (combined.contains("x86_64") || combined.contains("x86-64") || combined.contains("amd64")) return false;
+        return combined.contains("arm64") || combined.contains("aarch64");
+    }
