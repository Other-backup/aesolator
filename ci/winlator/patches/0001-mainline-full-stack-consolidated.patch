+        return joinSegments(" | ",
+                firstNonEmpty(renderTelemetry.rendererName, "OpenGL"),
+                !TextUtils.isEmpty(renderTelemetry.gpuName) ? trimMiddle(renderTelemetry.gpuName, 28) : null,
+                renderTelemetry.fpsVisible ? formatFps(renderTelemetry.fps) : null,
+                renderTelemetry.surfaceWidth > 0 && renderTelemetry.surfaceHeight > 0
+                        ? renderTelemetry.surfaceWidth + "x" + renderTelemetry.surfaceHeight
+                        : null);
