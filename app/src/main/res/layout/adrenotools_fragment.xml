<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/TVGraphicsCenterHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/graphics_center_hint" />

    <TextView
        android:id="@+id/TVGraphicsCenterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/graphics_center_status_empty"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TVGraphicsLaneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/graphics_center_lanes"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTLaneTurnip"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/icon_cpu"
            android:drawablePadding="6dp"
            android:minWidth="0dp"
            android:text="@string/graphics_center_lane_turnip" />

        <Space
            android:layout_width="10dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/BTLaneOpenGL"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/icon_screen_effect"
            android:drawablePadding="6dp"
            android:minWidth="0dp"
            android:text="@string/graphics_center_lane_opengl" />
    </LinearLayout>

    <TextView
        android:id="@+id/TVGraphicsDownloadsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/graphics_center_driver_feed_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TVGraphicsDownloadsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/graphics_center_driver_feed_hint"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/TVGraphicsFeedSourceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/contents_source_selector" />

    <Spinner
        android:id="@+id/SGraphicsFeedSourceMode"
        style="@style/ComboBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/LLGraphicsFeedFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/SGraphicsFeedChannelMode"
            style="@style/ComboBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/SGraphicsFeedArchMode"
            style="@style/ComboBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RVGraphicsFeed"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/TVGraphicsFeedEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/graphics_center_driver_feed_empty"
        android:visibility="gone" />

    <TextView
        android:id="@+id/TVGraphicsActionsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/graphics_center_actions"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTDri3Settings"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/open_dri3_settings" />

        <Space
            android:layout_width="10dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/BTForensicCenter"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/open_forensic_center" />
    </LinearLayout>

    <Button
        android:id="@+id/BTOpenUpscalerSettings"
        style="@style/ButtonNeutral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_upscaler_settings" />

    <androidx.recyclerview.widget.RecyclerView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/RecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        app:layoutManager="LinearLayoutManager" />
   

    <View style="@style/HorizontalLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTInstallDriver"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/install_drivers_local" />

        <Space
            android:layout_width="10dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/BTOpenContentsGraphics"
            style="@style/ButtonPositive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/open_contents_packages" />

    </LinearLayout>
</LinearLayout>
