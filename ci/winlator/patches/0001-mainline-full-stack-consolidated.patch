+    private File getManagedRemoteDownloadDir() {
+        File dir = new File(requireContext().getCacheDir(), "ae_contents_downloads");
+        if (!dir.exists()) dir.mkdirs();
+        return dir;
+    }
+
+    private File buildManagedRemoteDownloadFile(ContentProfile profile) {
+        String safeName = getRemoteDownloadKey(profile).replaceAll("[^a-z0-9._-]", "_");
+        return new File(getManagedRemoteDownloadDir(), safeName + ".wcp");
+    }
+
+    private File resolveManagedRemoteDownloadFile(@Nullable Uri uri) {
+        if (uri == null) return null;
+        String path = uri.getPath();
+        if (path == null || path.trim().isEmpty()) return null;
+
+        File candidate = new File(path);
+        try {
+            String managedRoot = getManagedRemoteDownloadDir().getCanonicalPath() + File.separator;
+            String candidatePath = candidate.getCanonicalPath();
+            if (!candidatePath.startsWith(managedRoot)) return null;
+            return candidate;
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private void deleteManagedRemoteDownload(@Nullable File file) {
+        if (file == null || !file.exists()) return;
+        FileUtils.delete(file);
+    }
+
+    private boolean isRemoteDownloadActive(ContentProfile profile) {
+        synchronized (activeRemoteDownloads) {
+            return activeRemoteDownloads.contains(getRemoteDownloadKey(profile));
+        }
+    }
+
+    private void setRemoteDownloadActive(ContentProfile profile, boolean active) {
+        synchronized (activeRemoteDownloads) {
+            String key = getRemoteDownloadKey(profile);
+            if (active) activeRemoteDownloads.add(key);
+            else activeRemoteDownloads.remove(key);
+        }
+    }
