+            obj.put("rxBytesPerSecond", hostSample.rxBytesPerSecond);
+            obj.put("txBytesPerSecond", hostSample.txBytesPerSecond);
+            JSONObject psi = new JSONObject();
+            psi.put("cpuSome10", hostSample.cpuPressureSome10);
+            psi.put("cpuFull10", hostSample.cpuPressureFull10);
+            psi.put("ioSome10", hostSample.ioPressureSome10);
+            psi.put("ioFull10", hostSample.ioPressureFull10);
