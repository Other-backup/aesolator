+    private String buildCpuClockSummary() {
+        short[] currentClocks = CPUStatus.getCurrentClockSpeeds();
+        if (currentClocks == null || currentClocks.length == 0) {
+            return activity.getString(R.string.task_manager_no_focus_meta);
+        }
+
+        int totalCurrent = 0;
+        int totalMax = 0;
+        for (int i = 0; i < currentClocks.length; i++) {
+            totalCurrent += Math.max(0, currentClocks[i]);
+            totalMax += Math.max(0, CPUStatus.getMaxClockSpeed(i));
+        }
+
+        int avgCurrent = totalCurrent / Math.max(1, currentClocks.length);
+        int avgMax = totalMax / Math.max(1, currentClocks.length);
+        return joinSegments(" | ",
+                currentClocks.length + " cores",
+                "avg " + avgCurrent + "/" + avgMax + " MHz");
+    }
