<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/LLMainMenuCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/surface_card_background"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:tag="preserve_background">

        <ImageView
            android:id="@+id/IVMainMenuCardIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:tag="no_theme_tint" />

        <TextView
            android:id="@+id/TVMainMenuCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVMainMenuCardHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="1"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
