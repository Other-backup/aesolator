+    private JSONObject buildTreeJson(TaskRow row) {
+        JSONObject obj = new JSONObject();
+        try {
+            obj.put("rootPid", row.rootPid);
+            obj.put("depth", row.treeDepth);
+            obj.put("childCount", row.childCount);
+            obj.put("metrics", firstNonEmpty(row.hierarchyMetrics, "root"));
+            JSONArray processTree = new JSONArray();
+            for (Integer pid : ProcessHelper.listProcessTree(row.pid, true)) {
+                processTree.put(pid);
+            }
+            obj.put("processTree", processTree);
+        } catch (JSONException ignored) {}
+        return obj;
+    }
+
+    private JSONObject buildProcessJson(TaskRow row) {
+        JSONObject obj = new JSONObject();
+        if (row.processSample == null) {
+            return obj;
