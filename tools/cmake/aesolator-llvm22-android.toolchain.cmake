set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_VERSION 26)
set(CMAKE_ANDROID_ARCH_ABI arm64-v8a)
set(CMAKE_ANDROID_STL_TYPE c++_shared)

if(NOT DEFINED AEO_LLVM22_ROOT OR "${AEO_LLVM22_ROOT}" STREQUAL "")
    if(DEFINED ENV{AEO_LLVM22_ROOT} AND NOT "$ENV{AEO_LLVM22_ROOT}" STREQUAL "")
        set(AEO_LLVM22_ROOT "$ENV{AEO_LLVM22_ROOT}")
    else()
        set(AEO_LLVM22_ROOT "/data/data/com.termux/files/home/.toolchains/llvm-22.1.1-termux")
    endif()
endif()

if(NOT DEFINED AEO_ANDROID_NDK_ROOT OR "${AEO_ANDROID_NDK_ROOT}" STREQUAL "")
    if(DEFINED ENV{ANDROID_NDK_ROOT} AND NOT "$ENV{ANDROID_NDK_ROOT}" STREQUAL "")
        set(AEO_ANDROID_NDK_ROOT "$ENV{ANDROID_NDK_ROOT}")
    elseif(DEFINED ENV{ANDROID_NDK_HOME} AND NOT "$ENV{ANDROID_NDK_HOME}" STREQUAL "")
        set(AEO_ANDROID_NDK_ROOT "$ENV{ANDROID_NDK_HOME}")
    else()
        set(AEO_ANDROID_NDK_ROOT "/data/data/com.termux/files/home/android-sdk/ndk/29.0.14206865")
    endif()
endif()

set(CMAKE_ANDROID_NDK "${AEO_ANDROID_NDK_ROOT}")
set(AEO_NDK_PREBUILT "${AEO_ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64")
set(AEO_NDK_SYSROOT "${AEO_NDK_PREBUILT}/sysroot")

set(CMAKE_SYSROOT "${AEO_NDK_SYSROOT}")
set(CMAKE_C_COMPILER "${AEO_LLVM22_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${AEO_LLVM22_ROOT}/bin/clang++")
set(CMAKE_AR "${AEO_LLVM22_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${AEO_LLVM22_ROOT}/bin/llvm-ranlib")
set(CMAKE_STRIP "${AEO_LLVM22_ROOT}/bin/llvm-strip")
set(CMAKE_LINKER "${AEO_LLVM22_ROOT}/bin/ld.lld")

set(CMAKE_C_COMPILER_TARGET aarch64-linux-android26)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-android26)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-android26)

set(CMAKE_FIND_ROOT_PATH "${AEO_NDK_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_FLAGS_INIT "--sysroot=${AEO_NDK_SYSROOT} -resource-dir ${AEO_NDK_PREBUILT}/lib/clang/21")
set(CMAKE_CXX_FLAGS_INIT "--sysroot=${AEO_NDK_SYSROOT} -resource-dir ${AEO_NDK_PREBUILT}/lib/clang/21")
