+    private ArrayList<TurnipSource> getActiveTurnipSources() {
+        ArrayList<TurnipSource> sources = new ArrayList<>();
+        String mode = getTurnipSourceMode();
+        for (TurnipSource source : TURNIP_SOURCES) {
+            if (TURNIP_SOURCE_MODE_PRIMARY.equals(mode) && !source.primary) {
+                continue;
+            }
+            sources.add(source);
+        }
+        if (sources.isEmpty()) {
+            sources.add(TURNIP_SOURCES[0]);
+        }
+        return sources;
+    }
