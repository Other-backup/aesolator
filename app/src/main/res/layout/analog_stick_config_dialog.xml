<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analogStickConfigScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/LLAnalogStickConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/analog_stick_hint"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/TVBoxLeftStick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/left_analog_stick_settings"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVLeftDeadzone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/deadzone_label" />

                <SeekBar
                    android:id="@+id/SBLeftDeadzone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/TVLeftSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sensitivity_label" />

                <SeekBar
                    android:id="@+id/SBLeftSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100" />

                <CheckBox
                    android:id="@+id/CBLeftStickSquareDeadzone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/use_square_deadzone_left" />

                <CheckBox
                    android:id="@+id/CBInvertLeftStickX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/invert_x_axis_left" />

                <CheckBox
                    android:id="@+id/CBInvertLeftStickY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/invert_y_axis_left" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/left_analog_stick_settings"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/TVBoxRightStick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/right_analog_stick_settings"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVRightDeadzone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/deadzone_label" />

                <SeekBar
                    android:id="@+id/SBRightDeadzone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/TVRightSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sensitivity_label" />

                <SeekBar
                    android:id="@+id/SBRightSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100" />

                <CheckBox
                    android:id="@+id/CBInvertRightStickX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/invert_x_axis_right" />

                <CheckBox
                    android:id="@+id/CBInvertRightStickY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/invert_y_axis_right" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/right_analog_stick_settings"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
