+    public static ArrayList<String> listInstalledOptRuntimeIdentifiers(Context context) {
+        ArrayList<String> runtimeIdentifiers = new ArrayList<>();
+        if (context == null) {
+            return runtimeIdentifiers;
+        }
+
+        ImageFs imageFs = ImageFs.find(context);
+        File optDir = imageFs != null ? new File(imageFs.getRootDir(), "opt") : null;
+        File[] candidates = optDir != null ? optDir.listFiles() : null;
+        if (candidates != null) {
+            for (File candidate : candidates) {
+                if (candidate != null && candidate.isDirectory()) {
+                    appendRuntimeIdentifier(runtimeIdentifiers, candidate.getName());
+                }
+            }
+        }
+
+        sortRuntimeIdentifiers(runtimeIdentifiers);
+        return runtimeIdentifiers;
+    }
+
+    public static ArrayList<String> listBundledAssetRuntimeIdentifiers(Context context) {
+        ArrayList<String> runtimeIdentifiers = new ArrayList<>();
+        if (context == null) {
+            return runtimeIdentifiers;
+        }
+
+        try {
+            String[] assetList = context.getAssets().list("");
+            if (assetList != null) {
+                for (String assetName : assetList) {
+                    if (assetName == null || !assetName.endsWith(".txz")) continue;
+                    appendRuntimeIdentifier(runtimeIdentifiers, assetName.substring(0, assetName.length() - 4));
+                }
+            }
+        } catch (IOException e) {
