+        sortRuntimeIdentifiers(runtimeIdentifiers);
+        return runtimeIdentifiers;
+    }
+
+    public static ArrayList<String> listSelectableRuntimeIdentifiers(Context context, ContentsManager contentsManager) {
+        ArrayList<String> runtimeIdentifiers = listInstalledOptRuntimeIdentifiers(context);
+        if (contentsManager != null) {
+            List<ContentProfile> profiles = contentsManager.getWineFamilyProfiles();
+            if (profiles != null) {
