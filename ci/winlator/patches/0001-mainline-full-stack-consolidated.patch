+
+        sortRuntimeIdentifiers(runtimeIdentifiers);
+        return runtimeIdentifiers;
+    }
+
+    public static ArrayList<RuntimeSelectionItem> listSelectableRuntimeItems(Context context, ContentsManager contentsManager) {
+        ArrayList<RuntimeSelectionItem> items = new ArrayList<>();
+        for (String identifier : listSelectableRuntimeIdentifiers(context, contentsManager)) {
+            items.add(new RuntimeSelectionItem(identifier, getRuntimeDisplayName(contentsManager, identifier)));
+        }
+        return items;
+    }
+
+    public static String getRuntimeDisplayName(ContentProfile profile) {
+        if (profile == null) return "";
+        String generated = buildGenericRuntimeDisplayName(parseIdentifier(buildProfileIdentifier(profile)));
+        String description = sanitizeRuntimeDescription(profile.desc);
+        if (!description.isEmpty()) {
+            String normalizedDescription = description.toLowerCase(Locale.ENGLISH);
+            if (profile.isProtonLike() && !normalizedDescription.contains("proton")) {
+                return generated;
+            }
+            if (profile.isWineLike() && normalizedDescription.contains("proton")) {
+                return generated;
+            }
+            return description;
+        }
+
+        return generated;
+    }
+
+    public static String getRuntimeDisplayName(ContentsManager contentsManager, String identifier) {
+        if (identifier == null || identifier.trim().isEmpty()) return "";
+
+        String normalizedIdentifier = identifier.trim().toLowerCase(Locale.ENGLISH);
+        ContentProfile profile = resolveWineProfile(contentsManager, normalizedIdentifier);
+        if (profile != null) {
+            String profileDisplayName = getRuntimeDisplayName(profile);
+            if (!profileDisplayName.isEmpty()) {
+                return profileDisplayName;
+            }
+        }
+
+        ParsedIdentifier parsed = parseIdentifier(normalizedIdentifier);
+        if (parsed == null) {
+            return identifier.trim();
+        }
+
+        return buildGenericRuntimeDisplayName(parsed);
+    }
+
+    private static ParsedIdentifier parseIdentifier(String identifier) {
+        if (identifier == null || identifier.trim().isEmpty()) {
+            return null;
+        }
+
+        String normalized = identifier.toLowerCase(Locale.ENGLISH).trim();
+
+        Matcher strictMatcher = strictPattern.matcher(normalized);
+        if (strictMatcher.matches()) {
+            String version = strictMatcher.group(2);
+            if (strictMatcher.group(3) != null && !strictMatcher.group(3).isEmpty()) {
+                version += "-" + strictMatcher.group(3);
+            }
+            return new ParsedIdentifier(strictMatcher.group(1), version, strictMatcher.group(4));
+        }
+
+        Matcher archMatcher = archSuffixPattern.matcher(normalized);
+        if (!archMatcher.find()) {
+            return null;
+        }
+
+        String arch = archMatcher.group(1);
+        String base = normalized.substring(0, archMatcher.start());
+        String type;
+        String version;
+
+        if (base.startsWith("proton-")) {
+            type = "proton";
+            version = base.substring("proton-".length());
+        } else if (base.startsWith("proton")) {
+            type = "proton";
+            version = base.substring("proton".length());
+        } else if (base.startsWith("wine-")) {
+            type = "wine";
+            version = base.substring("wine-".length());
+        } else if (base.startsWith("wine")) {
+            type = "wine";
+            version = base.substring("wine".length());
+        } else {
+            type = "wine";
+            version = base;
+        }
+
+        version = version.replaceAll("^-+", "").replaceAll("-+$", "");
+        if (version.isEmpty()) {
+            return null;
+        }
+
+        return new ParsedIdentifier(type, version, arch);
+    }
+
+    private static void appendRuntimeIdentifier(List<String> runtimeIdentifiers, String identifier) {
+        if (identifier == null) return;
+        String trimmed = identifier.trim();
+        if (trimmed.isEmpty() || parseIdentifier(trimmed) == null) return;
+        for (String existing : runtimeIdentifiers) {
+            if (existing.equalsIgnoreCase(trimmed)) {
+                return;
+            }
+        }
+        runtimeIdentifiers.add(trimmed);
+    }
+
+    private static void sortRuntimeIdentifiers(List<String> runtimeIdentifiers) {
+        Collections.sort(runtimeIdentifiers, new Comparator<String>() {
+            @Override
+            public int compare(String left, String right) {
+                return compareRuntimeIdentifiers(left, right);
+            }
+        });
+    }
+
+    private static int compareRuntimeIdentifiers(String left, String right) {
+        ParsedIdentifier parsedLeft = parseIdentifier(left);
+        ParsedIdentifier parsedRight = parseIdentifier(right);
+        if (parsedLeft == null || parsedRight == null) {
+            return String.CASE_INSENSITIVE_ORDER.compare(left, right);
+        }
+
+        int typeCompare = Integer.compare(typeRank(parsedLeft.type), typeRank(parsedRight.type));
+        if (typeCompare != 0) {
+            return typeCompare;
+        }
+
+        int versionCompare = compareVersionDesc(parsedLeft.version, parsedRight.version);
+        if (versionCompare != 0) {
+            return versionCompare;
+        }
+
+        int archCompare = Integer.compare(archRank(parsedLeft.arch), archRank(parsedRight.arch));
+        if (archCompare != 0) {
+            return archCompare;
+        }
+
+        return String.CASE_INSENSITIVE_ORDER.compare(left, right);
+    }
+
+    private static int typeRank(String type) {
+        if ("wine".equalsIgnoreCase(type)) return 0;
+        if ("proton".equalsIgnoreCase(type)) return 1;
+        return 2;
+    }
+
+    private static int archRank(String arch) {
+        if ("arm64ec".equalsIgnoreCase(arch)) return 0;
+        if ("x86_64".equalsIgnoreCase(arch)) return 1;
+        if ("x86".equalsIgnoreCase(arch)) return 2;
+        return 3;
+    }
+
+    private static int compareVersionDesc(String left, String right) {
+        String[] leftParts = left.split("[^0-9A-Za-z]+");
+        String[] rightParts = right.split("[^0-9A-Za-z]+");
+        int max = Math.max(leftParts.length, rightParts.length);
+        for (int i = 0; i < max; i++) {
+            String leftPart = i < leftParts.length ? leftParts[i] : "";
+            String rightPart = i < rightParts.length ? rightParts[i] : "";
+            int partCompare = compareVersionPartDesc(leftPart, rightPart);
+            if (partCompare != 0) {
+                return partCompare;
+            }
+        }
+        return 0;
+    }
+
+    private static int compareVersionPartDesc(String left, String right) {
+        boolean leftNumeric = left.matches("[0-9]+");
+        boolean rightNumeric = right.matches("[0-9]+");
+        if (leftNumeric && rightNumeric) {
+            try {
+                int numericCompare = Integer.compare(Integer.parseInt(right), Integer.parseInt(left));
+                if (numericCompare != 0) {
+                    return numericCompare;
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        } else if (leftNumeric != rightNumeric) {
+            return leftNumeric ? -1 : 1;
+        }
+
+        return right.compareToIgnoreCase(left);
+    }
+
+    private static String buildGenericRuntimeDisplayName(ParsedIdentifier parsed) {
+        if (parsed == null) return "";
+        String lowerVersion = parsed.version.toLowerCase(Locale.ENGLISH);
+        String family = "proton".equalsIgnoreCase(parsed.type) ? "Proton" : "Wine";
+        String versionTail = parsed.version;
+
+        if ("proton".equalsIgnoreCase(parsed.type) && lowerVersion.startsWith("wine")) {
+            family = "ProtonWine";
+            versionTail = parsed.version.substring(4);
+        } else if ("proton".equalsIgnoreCase(parsed.type) && lowerVersion.startsWith("ge")) {
+            family = "Proton GE";
+            versionTail = parsed.version.substring(2);
+        }
+
+        StringBuilder label = new StringBuilder(family);
+        String formattedVersion = formatRuntimeTokenGroup(versionTail);
+        if (!formattedVersion.isEmpty()) {
+            label.append(' ').append(formattedVersion);
+        }
+
+        String archLabel = formatArchLabel(parsed.arch);
+        if (!archLabel.isEmpty()) {
+            label.append(' ').append(archLabel);
+        }
+        return label.toString().trim();
+    }
+
+    private static String formatRuntimeTokenGroup(String value) {
+        if (value == null || value.trim().isEmpty()) return "";
+
+        StringBuilder formatted = new StringBuilder();
+        String[] tokens = value.trim().split("-");
+        for (String token : tokens) {
+            if (token == null || token.trim().isEmpty()) continue;
+            String normalized = token.trim();
+            String lower = normalized.toLowerCase(Locale.ENGLISH);
+            String rendered;
+            if ("gamenative".equals(lower)) {
+                rendered = "GameNative";
+            } else if ("custom".equals(lower)) {
+                rendered = "Custom";
+            } else {
+                rendered = normalized.replaceAll("([A-Za-z])([0-9])", "$1 $2")
+                        .replaceAll("([0-9])([A-Za-z])", "$1 $2");
+                if (rendered.matches("[a-z]+")) {
+                    rendered = Character.toUpperCase(rendered.charAt(0)) + rendered.substring(1);
+                }
+            }
+
+            if (formatted.length() > 0) {
+                formatted.append(' ');
+            }
+            formatted.append(rendered);
+        }
+        return formatted.toString().trim();
+    }
+
+    private static String formatArchLabel(String arch) {
+        if (arch == null || arch.trim().isEmpty()) return "";
+        String normalized = arch.trim().toLowerCase(Locale.ENGLISH);
+        if ("arm64ec".equals(normalized)) return "ARM64EC";
+        if ("x86_64".equals(normalized)) return "x86_64";
+        if ("x86".equals(normalized)) return "x86";
+        return arch.trim();
+    }
+
+    private static String sanitizeRuntimeDescription(String description) {
+        if (description == null) return "";
+        String sanitized = description.trim();
+        sanitized = sanitized.replaceAll("\\s*\\((?:rolling|custom|embedded)\\)\\s*$", "");
+        return sanitized.trim();
+    }
+
+    private static ContentProfile resolveWineProfile(ContentsManager contentsManager, String normalizedIdentifier) {
+        if (contentsManager == null || normalizedIdentifier == null || normalizedIdentifier.isEmpty()) {
+            return null;
+        }
+
+        ContentProfile profile = contentsManager.getProfileByEntryName(normalizedIdentifier);
+        if (profile != null) {
+            return profile;
+        }
+
+        String typedEntryName = ContentProfile.ContentType.CONTENT_TYPE_WINE + "-" + normalizedIdentifier;
+        profile = contentsManager.getProfileByEntryName(typedEntryName);
+        if (profile != null) {
+            return profile;
+        }
+
+        typedEntryName = ContentProfile.ContentType.CONTENT_TYPE_PROTON + "-" + normalizedIdentifier;
+        profile = contentsManager.getProfileByEntryName(typedEntryName);
+        if (profile != null) {
+            return profile;
+        }
+
+        int lastDashIndex = normalizedIdentifier.lastIndexOf('-');
+        if (lastDashIndex <= 0 || lastDashIndex >= normalizedIdentifier.length() - 1) {
+            return null;
+        }
+
+        String versionName = normalizedIdentifier.substring(0, lastDashIndex);
+        String versionCodeToken = normalizedIdentifier.substring(lastDashIndex + 1);
+        if (!versionCodeToken.matches("[0-9]+")) {
+            return null;
+        }
+
+        int versionCode;
+        try {
+            versionCode = Integer.parseInt(versionCodeToken);
+        } catch (NumberFormatException ignored) {
+            return null;
+        }
+
+        List<ContentProfile> profiles = contentsManager.getWineFamilyProfiles();
+        if (profiles == null) {
+            return null;
+        }
+
+        for (ContentProfile candidate : profiles) {
+            if (candidate == null) {
+                continue;
+            }
+            if (candidate.verCode == versionCode && versionName.equalsIgnoreCase(candidate.verName)) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+
+    private static String buildProfileIdentifier(ContentProfile profile) {
+        if (profile == null) return "";
+        String type = profile.isProtonLike() ? "proton" : "wine";
+        return type + "-" + profile.verName;
+    }
+
+    private static class ParsedIdentifier {
+        final String type;
+        final String version;
+        final String arch;
+
+        ParsedIdentifier(String type, String version, String arch) {
+            this.type = type;
+            this.version = version;
+            this.arch = arch;
+        }
+    }
+
+    public static final class RuntimeSelectionItem {
+        public final String identifier;
+        public final String displayName;
+
+        public RuntimeSelectionItem(String identifier, String displayName) {
+            this.identifier = identifier == null ? "" : identifier.trim();
+            this.displayName = displayName == null || displayName.trim().isEmpty()
+                    ? this.identifier : displayName.trim();
+        }
+
+        public boolean isPlaceholder() {
+            return identifier.isEmpty();
+        }
+
+        @NonNull
+        @Override
+        public String toString() {
+            return displayName;
+        }
+    }
+}
