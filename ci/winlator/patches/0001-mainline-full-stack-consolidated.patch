+    private <T> Spinner addSpinnerRow(LinearLayout root, String label, T[] options, int selectedIndex) {
+        final int padding = (int) (16f * getResources().getDisplayMetrics().density);
+        TextView tv = new TextView(getContext());
+        tv.setText(label);
+        tv.setPadding(0, padding / 2, 0, 0);
+        root.addView(tv);
+
+        Spinner spinner = new Spinner(getContext());
+        spinner.setAdapter(new ArrayAdapter<>(getContext(), android.R.layout.simple_spinner_dropdown_item, options));
+        spinner.setSelection(Math.max(0, selectedIndex));
+        root.addView(spinner);
+        return spinner;
+    }
