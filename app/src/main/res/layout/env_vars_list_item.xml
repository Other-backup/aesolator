<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/TextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.85"
        android:ellipsize="end"
        android:maxLines="1"
        android:scrollHorizontally="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1.15"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/Spinner"
            android:visibility="gone"
            android:spinnerMode="dropdown"/>

        <com.winlator.cmod.widget.MultiSelectionComboBox
            style="@style/MultiSelectionComboBox"
            android:id="@+id/MultiSelectionComboBox"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:spinnerMode="dropdown"/>

        <ToggleButton
            style="@style/ToggleButtonCompact"
            android:id="@+id/ToggleButton"
            android:visibility="gone" />

        <EditText
            style="@style/EditText"
            android:id="@+id/EditText"
            android:layout_width="match_parent"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        style="@style/ListMenuButton"
        android:id="@+id/BTRemove"
        android:src="@drawable/ae_icon_remove" />
</LinearLayout>
