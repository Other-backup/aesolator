+    private void requestImmediateRefresh() {
+        requestProcessRefresh(true);
+        renderSnapshot();
+    }
+
+    private void requestProcessRefresh(boolean force) {
+        long now = SystemClock.elapsedRealtime();
+        if (processRequestInFlight && now - processRequestStartedAtMs < 250L) {
+            return;
+        }
+        if (processRequestInFlight && now - processRequestStartedAtMs < PROCESS_REQUEST_TIMEOUT_MS && !force) {
+            return;
+        }
+
+        processRequestInFlight = true;
+        processRequestStartedAtMs = now;
+        pendingProcessBatch.clear();
+        activity.getWinHandler().listProcesses();
+    }
+
+    private void consumeProcessInfo(int index, int count, ProcessInfo processInfo) {
+        if (closed) {
+            return;
+        }
+
+        if (index == 0) {
+            pendingProcessBatch.clear();
+        }
+        if (processInfo != null) {
+            pendingProcessBatch.add(processInfo);
+        }
+
+        if (count == 0 || index >= count - 1) {
+            latestProcessMap.clear();
+            for (ProcessInfo item : pendingProcessBatch) {
+                latestProcessMap.put(item.pid, item);
+            }
+            processRequestInFlight = false;
+            renderSnapshot();
+        }
+    }
+
+    private void scheduleWindowRefresh() {
+        mainHandler.removeCallbacks(debouncedWindowRefreshRunnable);
+        mainHandler.postDelayed(debouncedWindowRefreshRunnable, WINDOW_EVENT_DEBOUNCE_MS);
+    }
