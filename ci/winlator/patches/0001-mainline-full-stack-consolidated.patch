+    public static ArrayList<Integer> listRuntimeProcessIds() {
+        File proc = new File("/proc");
+        ArrayList<Integer> runtimePids = new ArrayList<>();
+        String[] allPids = proc.list(new FilenameFilter() {
+            @Override
+            public boolean accept(File dir, String filename) {
+                return new File(dir, filename).isDirectory() && filename.matches("[0-9]+");
+            }
+        });
+        if (allPids == null) {
+            return runtimePids;
+        }
+
+        for (String pidValue : allPids) {
+            int pid = safeParseInt(pidValue, -1);
+            if (pid <= 0) {
+                continue;
+            }
+            if (isRuntimeProcess(proc, pidValue)) {
+                runtimePids.add(pid);
+            }
+        }
+        return runtimePids;
+    }
+
+    private static Map<Integer, ArrayList<Integer>> buildChildProcessMap() {
+        Map<Integer, ArrayList<Integer>> childrenByParent = new HashMap<>();
+        File proc = new File("/proc");
+        String[] allPids = proc.list((dir, filename) -> new File(dir, filename).isDirectory() && filename.matches("[0-9]+"));
+        if (allPids == null) {
+            return childrenByParent;
+        }
+
+        for (String pidValue : allPids) {
+            int pid = safeParseInt(pidValue, -1);
+            if (pid <= 0) {
+                continue;
+            }
+
+            int parentPid = readParentPid(proc, pidValue);
+            if (parentPid <= 0 || parentPid == pid) {
+                continue;
+            }
+
+            ArrayList<Integer> children = childrenByParent.get(parentPid);
+            if (children == null) {
+                children = new ArrayList<>();
+                childrenByParent.put(parentPid, children);
+            }
+            children.add(pid);
+        }
+        return childrenByParent;
+    }
+
+    private static void collectProcessTree(int pid, Map<Integer, ArrayList<Integer>> childrenByParent,
+                                           LinkedHashSet<Integer> ordered) {
+        if (pid <= 0 || ordered.contains(pid)) {
+            return;
+        }
+
+        ArrayList<Integer> children = childrenByParent.get(pid);
+        if (children != null) {
+            for (int childPid : children) {
+                collectProcessTree(childPid, childrenByParent, ordered);
+            }
+        }
+        ordered.add(pid);
+    }
+
+    private static int readParentPid(File procRoot, String pidValue) {
+        File statusFile = new File(procRoot, pidValue + "/status");
+        if (!statusFile.isFile()) {
+            return -1;
+        }
+
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(statusFile)))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.startsWith("PPid:")) {
+                    return safeParseInt(line.substring("PPid:".length()).trim(), -1);
+                }
+            }
+        }
+        catch (IOException ignored) {}
+        return -1;
+    }
+
+    private static int safeParseInt(String value, int fallback) {
+        try {
+            return Integer.parseInt(value);
+        }
+        catch (NumberFormatException ignored) {
+            return fallback;
+        }
+    }
+
+    private static boolean isRuntimeProcess(File procRoot, String pidValue) {
+        String statLine = readProcFirstLine(procRoot, pidValue + "/stat");
+        String commandName = readProcFirstLine(procRoot, pidValue + "/comm");
+        String commandLine = readProcText(procRoot, pidValue + "/cmdline", true);
+        String combined = (statLine + " " + commandName + " " + commandLine).toLowerCase(Locale.ROOT);
+        if (combined.isEmpty()) {
+            return false;
+        }
+        return combined.contains("wine")
+                || combined.contains("proton")
+                || combined.contains(".exe")
+                || combined.contains("wineserver")
+                || combined.contains("services.exe")
+                || combined.contains("explorer.exe");
+    }
+
+    private static String readProcFirstLine(File procRoot, String relativePath) {
+        File file = new File(procRoot, relativePath);
+        if (!file.isFile()) {
+            return "";
+        }
+
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(file)))) {
+            String line = reader.readLine();
+            return line != null ? line.trim() : "";
+        }
+        catch (IOException ignored) {}
+        return "";
+    }
+
+    private static String readProcText(File procRoot, String relativePath, boolean normalizeNulls) {
+        File file = new File(procRoot, relativePath);
+        if (!file.isFile()) {
+            return "";
+        }
+
+        try (FileInputStream inputStream = new FileInputStream(file)) {
+            byte[] data = new byte[8192];
+            int read = inputStream.read(data);
+            if (read <= 0) {
+                return "";
+            }
+            String text = new String(data, 0, read);
+            if (normalizeNulls) {
+                text = text.replace('\0', ' ');
+            }
+            return text.trim();
+        }
+        catch (IOException ignored) {}
+        return "";
+    }
+}
