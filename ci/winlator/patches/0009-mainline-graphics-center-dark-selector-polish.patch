+    private <T> ArrayAdapter<T> buildThemedSpinnerAdapter(T[] options) {
+        ArrayAdapter<T> adapter = new ArrayAdapter<T>(requireContext(), android.R.layout.simple_spinner_item, options) {
+            @Override
+            public @NonNull View getView(int position, View convertView, @NonNull ViewGroup parent) {
+                View view = super.getView(position, convertView, parent);
+                styleSpinnerItemView(view, false);
+                return view;
+            }
+
+            @Override
+            public View getDropDownView(int position, View convertView, @NonNull ViewGroup parent) {
+                View view = super.getDropDownView(position, convertView, parent);
+                styleSpinnerItemView(view, true);
+                return view;
+            }
+        };
+        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
+        return adapter;
+    }
+
+    private void styleSpinnerItemView(View view, boolean dropdown) {
+        if (!(view instanceof TextView) || !isDarkModeEnabled()) return;
+        TextView textView = (TextView) view;
+        textView.setTextColor(ContextCompat.getColor(requireContext(), dropdown ? R.color.colorAccentDark : R.color.white));
+        if (dropdown) {
+            textView.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.content_dialog_background_dark));
+        }
+    }
+
+    private void applySpinnerTheme(Spinner spinner) {
+        if (spinner == null || !isAdded()) return;
+        if (isDarkModeEnabled()) {
+            spinner.setBackgroundResource(R.drawable.combo_box_dark);
+            spinner.setPopupBackgroundResource(R.drawable.content_dialog_background_dark);
+        } else {
+            spinner.setBackgroundResource(R.drawable.combo_box);
+            spinner.setPopupBackgroundResource(R.drawable.content_dialog_background);
+        }
+    }
+
+    private boolean isDarkModeEnabled() {
+        if (!isAdded()) return isDarkMode;
+        isDarkMode = PreferenceManager.getDefaultSharedPreferences(requireContext()).getBoolean("dark_mode", isDarkMode);
+        return isDarkMode;
+    }
+
