<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLContainerIdentityCard"
                    android:tag="theme_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/name" />

                    <EditText
                        style="@style/EditText"
                        android:id="@+id/ETName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/screen_size" />

                            <Spinner
                                android:id="@+id/SScreenSize"
                                style="@style/ComboBox"
                                android:layout_width="match_parent"
                                android:entries="@array/screen_size_entries"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:spinnerMode="dialog" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LLCustomScreenSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/width" />

                                <EditText
                                    android:id="@+id/ETScreenWidth"
                                    style="@style/EditText"
                                    android:layout_width="78dp"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="4dp"
                                android:layout_marginBottom="6dp"
                                android:text="x"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/height" />

                                <EditText
                                    android:id="@+id/ETScreenHeight"
                                    style="@style/EditText"
                                    android:layout_width="78dp"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/LLWineVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wine_version" />

                        <Spinner
                            android:id="@+id/SWineVersion"
                            style="@style/ComboBox"
                            android:layout_width="match_parent" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TVContainerIdentity"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/general" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLContainerRuntimeCard"
                    android:tag="theme_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/graphics_driver" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/SGraphicsDriver"
                            style="@style/ComboBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:entries="@array/graphics_driver_entries" />

                        <ImageButton
                            android:id="@+id/BTGraphicsDriverConfig"
                            style="@style/ListMenuButton"
                            android:src="@drawable/icon_settings"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dxwrapper" />

                        <ImageView
                            android:id="@+id/BTHelpDXWrapper"
                            style="@style/HelpButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/SDXWrapper"
                            style="@style/ComboBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:entries="@array/dxwrapper_entries" />

                        <ImageButton
                            android:id="@+id/BTDXWrapperConfig"
                            style="@style/ListMenuButton"
                            android:src="@drawable/icon_settings"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/audio_driver" />

                    <Spinner
                        android:id="@+id/SAudioDriver"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:entries="@array/audio_driver_entries" />

                    <LinearLayout
                        android:id="@+id/LLEmulator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64bit Emulator" />

                        <Spinner
                            android:id="@+id/SEmulator64"
                            style="@style/ComboBox"
                            android:layout_width="match_parent"
                            android:entries="@array/emulator_entries" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dll_emulator" />

                        <Spinner
                            android:id="@+id/SEmulator"
                            style="@style/ComboBox"
                            android:layout_width="match_parent"
                            android:entries="@array/emulator_entries" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/midi_sound_font" />

                    <Spinner
                        android:id="@+id/SMIDISoundFont"
                        style="@style/ComboBox"
                        android:layout_width="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/lc_all" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/ETlcall"
                            style="@style/EditText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/BTShowLCALL"
                            style="@style/ListMenuButton"
                            android:src="@drawable/icon_menu" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/CBShowFPS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/show_fps" />

                    <CheckBox
                        android:id="@+id/CBFullscreenStretched"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fullscreen_stretched" />
                </LinearLayout>

                <TextView
                    android:id="@+id/TVContainerRuntime"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/container_runtime_routing" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">

                    <CheckBox
                        android:id="@+id/CBContainerFgEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_enable_frame_generation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_preset" />

                    <Spinner
                        android:id="@+id/SContainerFgPreset"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:entries="@array/upscaler_preset_entries" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_framegen_mode" />

                    <Spinner
                        android:id="@+id/SContainerFgMode"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:entries="@array/upscaler_framegen_mode_entries" />

                    <CheckBox
                        android:id="@+id/CBContainerFgThermalGuard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_thermal_guard" />

                    <TextView
                        android:id="@+id/TVContainerFgHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/container_fg_hint"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/TVContainerFramegen"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/container_fg_defaults" />
            </FrameLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/TabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/tab_layout_background"
                app:tabGravity="center"
                app:tabMode="auto">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wine_configuration" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/win_components" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/environment_variables" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/drives" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xr" />
            </com.google.android.material.tabs.TabLayout>

            <LinearLayout
                android:id="@+id/LLTabWineConfiguration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout style="@style/FieldSet">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SDesktopTheme"
                            android:layout_width="match_parent"
                            android:entries="@array/desktop_theme_entries" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/background" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/SDesktopBackgroundType"
                                style="@style/ComboBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:entries="@array/desktop_background_type_entries" />

                            <com.winlator.cmod.widget.ColorPickerView
                                android:id="@+id/CPVDesktopBackgroundColor"
                                android:layout_width="84dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <com.winlator.cmod.widget.ImagePickerView
                                android:id="@+id/IPVDesktopBackgroundImage"
                                android:layout_width="84dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/FieldSetLabel"
                        android:id="@+id/TVDesktop"
                        android:text="@string/desktop" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout style="@style/FieldSet">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mouse_warp_override" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SMouseWarpOverride"
                            android:layout_width="match_parent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/TVDirectInput"
                        style="@style/FieldSetLabel"
                        android:text="DirectInput" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLTabWinComponents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        style="@style/FieldSet"
                        android:id="@+id/LLWinComponentsDirectX" />

                    <TextView
                        android:id="@+id/TVDirectX"
                        style="@style/FieldSetLabel"
                        android:text="@string/directx" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        style="@style/FieldSet"
                        android:id="@+id/LLWinComponentsGeneral" />

                    <TextView
                        android:id="@+id/TVGeneral"
                        style="@style/FieldSetLabel"
                        android:text="@string/general" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLTabEnvVars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.winlator.cmod.widget.EnvVarsView
                    android:id="@+id/EnvVarsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>

                <View style="@style/HorizontalLine" />

                <Button
                    style="@style/ButtonNeutral"
                    android:id="@+id/BTAddEnvVar"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLTabDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/letter" />

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/target_path" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLDrives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>

                <TextView
                    android:id="@+id/TVDrivesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/no_items_to_display"
                    android:padding="16dp"
                    android:visibility="gone" />

                <View style="@style/HorizontalLine" />

                <Button
                    style="@style/ButtonNeutral"
                    android:id="@+id/BTAddDrive"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLTabAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/box64Frame">

                    <LinearLayout style="@style/FieldSet">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/box64_version" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Version"
                            android:layout_width="match_parent"
                            android:spinnerMode="dialog" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/box64_preset" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Preset"
                            android:layout_width="match_parent"
                            android:spinnerMode="dialog" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/TVBox64"
                        style="@style/FieldSetLabel"
                        android:text="@string/box64" />
                </FrameLayout>
                
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/fexcoreFrame"
                    android:layout_marginTop="8dp">
                
                    <LinearLayout style="@style/FieldSet">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fexcore_version" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCoreVersion"
                            android:layout_width="match_parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fexcore_preset" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCorePreset"
                            android:layout_width="match_parent"
                            android:spinnerMode="dialog" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/TVFEXCore"
                        style="@style/FieldSetLabel"
                        android:text="@string/fexcore_config" />
                    
                </FrameLayout>
                
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout style="@style/FieldSet">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/startup_selection" />

                        <Spinner
                            style="@style/ComboBox"
                            android:layout_width="match_parent"
                            android:id="@+id/SStartupSelection"
                            android:entries="@array/startup_selection_entries" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/TVSystem"
                        style="@style/FieldSetLabel"
                        android:text="@string/system" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout style="@style/FieldSet">

                        <LinearLayout
                            android:id="@+id/LLDinputMapperType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/directinput_mapper_type" />

                            <Spinner
                                style="@style/ComboBox"
                                android:id="@+id/SDInputType"
                                android:layout_width="match_parent"
                                android:entries="@array/dinput_mapper_type_entries" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <CheckBox
                                android:id="@+id/CBEnableXInput"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/enable_xinput_for_wine_game" />

                            <ImageView
                                android:id="@+id/BTXInputHelp"
                                style="@style/HelpButton"
                                android:layout_gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <CheckBox
                                android:id="@+id/CBEnableDInput"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/enable_dinput_for_wine_game" />



                            <ImageView
                                android:id="@+id/BTDInputHelp"
                                style="@style/HelpButton"
                                android:layout_gravity="center" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/CBSdl2Toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable SDL2 Compatibility" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/TVGameController"
                        style="@style/FieldSetLabel"
                        android:text="@string/game_controller" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/processor_affinity"
                    android:layout_marginTop="8dp" />

                <com.winlator.cmod.widget.CPUListView
                    android:id="@+id/CPUListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/processor_affinity_32_bit_apps"
                    android:layout_marginTop="8dp" />

                <com.winlator.cmod.widget.CPUListView
                    android:id="@+id/CPUListViewWoW64"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLTabXR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/primary_controller" />
                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:id="@+id/SPrimaryController"
                    android:entries="@array/xr_controllers" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_a" />
                <Spinner
                    style="@style/ComboBox"
