+    private static String buildRssBreakdownMetric(LinuxTelemetrySampler.ProcessSample processSample) {
+        return joinSegments(" | ",
+                processSample.rssAnonBytes >= 0L ? "ANON " + StringUtils.formatBytes(processSample.rssAnonBytes) : null,
+                processSample.rssFileBytes >= 0L ? "FILE " + StringUtils.formatBytes(processSample.rssFileBytes) : null,
+                processSample.rssShmemBytes >= 0L ? "SHM " + StringUtils.formatBytes(processSample.rssShmemBytes) : null,
+                processSample.swapBytes >= 0L ? "SWAP " + StringUtils.formatBytes(processSample.swapBytes) : null);
+    }
+
+    private static String formatContextSwitchTotals(LinuxTelemetrySampler.ProcessSample processSample) {
+        if (processSample.totalContextSwitches < 0L) {
+            return "n/a";
+        }
+        return joinSegments(" | ",
+                "total " + processSample.totalContextSwitches,
+                processSample.voluntaryContextSwitches >= 0L ? "vol " + processSample.voluntaryContextSwitches : null,
+                processSample.nonVoluntaryContextSwitches >= 0L ? "nonvol " + processSample.nonVoluntaryContextSwitches : null);
+    }
+
+    private static String describeSchedulingPolicy(int schedulingPolicy) {
+        switch (schedulingPolicy) {
+            case 0:
+                return "CFS";
+            case 1:
+                return "FIFO";
+            case 2:
+                return "RR";
+            case 3:
+                return "BATCH";
+            case 5:
+                return "IDLE";
+            case 6:
+                return "DL";
+            default:
+                return schedulingPolicy >= 0 ? "P" + schedulingPolicy : "n/a";
+        }
+    }
+
+    private static int resolveRootPid(TaskRow row, android.util.SparseArray<TaskRow> rowByPid) {
+        int rootPid = row.pid;
+        int parentPid = row.processSample != null ? row.processSample.parentPid : 0;
+        int depth = 0;
+        while (parentPid > 0 && parentPid != rootPid && depth < 16) {
+            TaskRow parentRow = rowByPid.get(parentPid);
+            if (parentRow == null) {
+                break;
+            }
+            rootPid = parentRow.pid;
+            parentPid = parentRow.processSample != null ? parentRow.processSample.parentPid : 0;
+            depth++;
+        }
+        return rootPid;
+    }
+
+    private static int computeTreeDepth(TaskRow row, android.util.SparseArray<TaskRow> rowByPid) {
+        int depth = 0;
+        int parentPid = row.processSample != null ? row.processSample.parentPid : 0;
+        while (parentPid > 0 && depth < 16) {
+            TaskRow parentRow = rowByPid.get(parentPid);
+            if (parentRow == null || parentRow.pid == row.pid) {
+                break;
+            }
+            depth++;
+            parentPid = parentRow.processSample != null ? parentRow.processSample.parentPid : 0;
+        }
+        return depth;
+    }
+
+    private static android.util.SparseArray<TreeGroupStats> buildTreeGroupStats(ArrayList<TaskRow> rows) {
+        android.util.SparseArray<TreeGroupStats> stats = new android.util.SparseArray<>();
+        for (TaskRow row : rows) {
+            TreeGroupStats group = stats.get(row.rootPid);
+            if (group == null) {
+                group = new TreeGroupStats(row.displayName);
+                stats.put(row.rootPid, group);
+            }
+            if (row.treeDepth == 0 && !TextUtils.isEmpty(row.displayName)) {
+                group.rootLabel = row.displayName;
+            }
+            group.hasFocusedDescendant |= row.isFocused();
+            group.hasRenderDescendant |= row.isRenderTarget();
+            group.maxVisibleWindows = Math.max(group.maxVisibleWindows, row.getVisibleWindowCount());
+            group.maxCpuPercent = Math.max(group.maxCpuPercent, row.getCpuPercent());
+            group.totalResidentBytes += row.getResidentBytes();
+        }
+        return stats;
+    }
+
+    private static TreeGroupStats getTreeGroupStats(android.util.SparseArray<TreeGroupStats> groupStats, int rootPid) {
+        TreeGroupStats stats = groupStats.get(rootPid);
+        return stats != null ? stats : new TreeGroupStats("");
+    }
+
+    private static String buildTreeLabel(String displayName, int depth) {
+        if (depth <= 0) {
+            return displayName;
+        }
+        StringBuilder builder = new StringBuilder(displayName.length() + (depth * 2) + 3);
+        for (int i = 0; i < depth; i++) {
+            builder.append("  ");
+        }
+        builder.append("|- ").append(displayName);
+        return builder.toString();
+    }
+
+    private static String buildHierarchyMetric(TaskRow row) {
+        return joinSegments(" | ",
+                row.treeDepth == 0 ? "TREE root" : "TREE d" + row.treeDepth,
+                row.processSample != null && row.processSample.parentPid > 0 ? "parent " + row.processSample.parentPid : null,
+                row.childCount > 0 ? "child " + row.childCount : null,
+                row.rootPid != row.pid ? "root " + row.rootPid : null);
+    }
+
+    private static String joinSegments(String delimiter, String... values) {
+        ArrayList<String> parts = new ArrayList<>();
+        for (String value : values) {
+            if (!TextUtils.isEmpty(value)) {
+                parts.add(value);
+            }
+        }
+        return TextUtils.join(delimiter, parts);
+    }
+
+    private static String trimMiddle(String value, int maxLength) {
+        if (TextUtils.isEmpty(value) || value.length() <= maxLength) {
+            return value;
+        }
+
+        int head = Math.max(1, (maxLength - 3) / 2);
+        int tail = Math.max(1, maxLength - 3 - head);
+        return value.substring(0, head) + "..." + value.substring(value.length() - tail);
+    }
+
+    private static String firstNonEmpty(String... values) {
+        for (String value : values) {
+            if (!TextUtils.isEmpty(value)) {
+                return value;
+            }
+        }
+        return "";
+    }
+
+    private static final class WindowSnapshot {
+        final int pid;
+        int totalWindows;
+        int mappedWindows;
+        int applicationWindows;
+        int representativeWindowId = -1;
+        boolean focused;
+        boolean containsTrackedFrameWindow;
+        long handle;
+        String windowTitle = "";
+        String className = "";
+        Bitmap icon;
+        int representativeScore = Integer.MIN_VALUE;
+
+        WindowSnapshot(int pid) {
+            this.pid = pid;
+        }
+    }
+
+    private static final class TaskRow {
+        final int pid;
+        final String displayName;
+        final String subtitle;
+        final String primaryMetrics;
+        final String secondaryMetrics;
+        final String tertiaryMetrics;
+        final String quaternaryMetrics;
+        final String stateLabel;
+        final ProcessInfo processInfo;
+        final LinuxTelemetrySampler.ProcessSample processSample;
+        final WindowSnapshot windowSnapshot;
+        final Bitmap icon;
+        final boolean renderTarget;
+        int treeDepth;
+        int childCount;
+        int rootPid;
+        String treeLabel = "";
+        String hierarchyMetrics = "";
+
+        TaskRow(int pid, String displayName, String subtitle, String primaryMetrics, String secondaryMetrics,
+                String tertiaryMetrics, String quaternaryMetrics,
+                String stateLabel, ProcessInfo processInfo, LinuxTelemetrySampler.ProcessSample processSample,
+                WindowSnapshot windowSnapshot, Bitmap icon, boolean renderTarget) {
+            this.pid = pid;
+            this.displayName = displayName;
+            this.subtitle = subtitle;
+            this.primaryMetrics = primaryMetrics;
+            this.secondaryMetrics = secondaryMetrics;
+            this.tertiaryMetrics = tertiaryMetrics;
+            this.quaternaryMetrics = quaternaryMetrics;
+            this.stateLabel = stateLabel;
+            this.processInfo = processInfo;
+            this.processSample = processSample;
+            this.windowSnapshot = windowSnapshot;
+            this.icon = icon;
+            this.renderTarget = renderTarget;
+            this.rootPid = pid;
+        }
+
+        boolean isFocused() {
+            return windowSnapshot != null && windowSnapshot.focused;
+        }
+
+        int getVisibleWindowCount() {
+            return windowSnapshot != null ? windowSnapshot.mappedWindows : 0;
+        }
+
+        float getCpuPercent() {
+            return processSample != null ? processSample.cpuPercent : 0f;
+        }
+
+        long getResidentBytes() {
+            return processSample != null ? processSample.residentBytes : 0L;
+        }
+
+        boolean isRenderTarget() {
+            return renderTarget;
+        }
+
+        boolean canBringToFront() {
+            return windowSnapshot != null && (windowSnapshot.handle != 0L || !TextUtils.isEmpty(displayName));
+        }
+    }
+
+    private static final class TreeGroupStats {
+        boolean hasFocusedDescendant;
+        boolean hasRenderDescendant;
+        int maxVisibleWindows;
+        float maxCpuPercent;
+        long totalResidentBytes;
+        String rootLabel;
+
+        TreeGroupStats(String rootLabel) {
+            this.rootLabel = rootLabel;
+        }
+    }
+}
