<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/FLContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/LLControlsEditorToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="12dp"
        android:background="@drawable/surface_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:tag="theme_card">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_badge_background"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:tag="theme_badge"
                android:text="@string/control_editor_toolbar_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/control_editor_toolbar_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/BTAddElement"
                style="@style/ListMenuButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/icon_add" />

            <ImageButton
                android:id="@+id/BTRemoveElement"
                style="@style/ListMenuButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/icon_remove" />

            <ImageButton
                android:id="@+id/BTElementSettings"
                style="@style/ListMenuButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/icon_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
