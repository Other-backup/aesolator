<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/LLTaskManagerBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/LLTabLinuxProcesses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="0dp">

            <LinearLayout
                android:id="@+id/LLLinuxProcessSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/surface_runtime_taskmgr_background"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/TVLinuxListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/surface_runtime_taskmgr_header_background"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/task_manager_linux_list_title"
                    android:textColor="@color/surface_runtime_taskmgr_text"
                    android:textSize="11.6sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/LLLinuxTableHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/surface_runtime_taskmgr_header_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.55"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:text="@string/task_manager_process_detail_header"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:gravity="center"
                        android:text="@string/state"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.86"
                        android:gravity="center"
                        android:text="@string/pid"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="center"
                        android:text="@string/cpu_short"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.02"
                        android:gravity="center"
                        android:text="@string/memory"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.02"
                        android:gravity="center"
                        android:text="@string/task_manager_io"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/FLLinuxProcessViewport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RVLinuxProcessList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:fadeScrollbars="false"
                        android:paddingBottom="0dp"
                        android:scrollbarStyle="outsideInset" />

                    <TextView
                        android:id="@+id/TVEmptyLinuxText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/task_manager_linux_no_items"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/SVTaskManagerSidebar"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:scrollbarStyle="outsideInset">

            <LinearLayout
                android:id="@+id/LLTaskManagerSidebarContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                android:id="@+id/LLSelectedLinuxProcessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_taskmgr_background"
                android:orientation="vertical"
                android:padding="4dp">

                    <TextView
                        android:id="@+id/TVSelectedLinuxProcessTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_manager_selected_process"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="11.4sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TVSelectedLinuxProcessName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="10.2sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TVSelectedLinuxProcessMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="2"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="8.4sp" />

                    <TextView
                        android:id="@+id/TVSelectedLinuxProcessCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="8.1sp" />

                    <Button
                        android:id="@+id/BTLinuxInspect"
                        style="@style/ButtonInlineRuntimeNeutral"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:minHeight="0dp"
                        android:text="@string/task_manager_action_inspect" />

                    <Button
                        android:id="@+id/BTLinuxPauseResume"
                        style="@style/ButtonInlineRuntimeNeutral"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:minHeight="0dp"
                        android:text="@string/task_manager_action_pause" />

                    <Button
                        android:id="@+id/BTLinuxTerminate"
                        style="@style/ButtonInlineRuntimeNeutral"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:minHeight="0dp"
                        android:text="@string/task_manager_action_terminate" />

                    <Button
                        android:id="@+id/BTLinuxKill"
                        style="@style/ButtonInlineRuntimePositive"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:minHeight="0dp"
                        android:text="@string/task_manager_action_kill" />

                    <CheckBox
                        android:id="@+id/CBLinuxRuntimeOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checked="true"
                        android:text="@string/task_manager_linux_runtime_only"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLTaskManagerCpuCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_runtime_taskmgr_background"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/TVCPUTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="11.8sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/LLCPUInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLTaskManagerMemoryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_runtime_taskmgr_background"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/TVMemoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="11.8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TVMemoryInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="10.2sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLTaskManagerTelemetryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_runtime_taskmgr_background"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/TVHostTelemetryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_manager_runtime_telemetry"
                        android:textColor="@color/surface_runtime_taskmgr_text"
                        android:textSize="11.8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TVHostLoadInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="9.6sp" />

                    <TextView
                        android:id="@+id/TVHostNetInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="9.6sp" />

                    <TextView
                        android:id="@+id/TVHostPressureInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="9.6sp" />

                    <TextView
                        android:id="@+id/TVProcessCountersInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/surface_runtime_taskmgr_muted"
                        android:textSize="9.6sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLTaskManagerActionsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_runtime_taskmgr_background"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/BTRuntimeRunCommand"
                        style="@style/ButtonInlineRuntimeNeutral"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:minHeight="0dp"
                        android:text="@string/task_manager_run_command" />

                    <Button
                        android:id="@+id/BTRuntimeClose"
                        style="@style/ButtonInlineRuntimeNeutral"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="6dp"
                        android:minHeight="0dp"
                        android:text="@string/close" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
