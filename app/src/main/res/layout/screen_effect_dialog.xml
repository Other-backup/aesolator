<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="1dp"
    android:paddingBottom="2dp"
    android:tag="compact_runtime_dialog preserve_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="1dp"
        android:paddingTop="0dp"
        android:paddingEnd="1dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.18"
            android:layout_marginEnd="4dp"
            android:background="@drawable/surface_runtime_taskmgr_background"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp"
            android:tag="theme_card preserve_background">

            <TextView
                android:id="@+id/LBLColorAdjustment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_taskmgr_header_background"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/color_adjustment"
                android:textColor="@color/surface_runtime_taskmgr_text"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/brightness" />

            <com.winlator.cmod.widget.SeekBar
                android:id="@+id/SBBrightness"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                app:maxValue="50"
                app:minValue="-50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/contrast" />

            <com.winlator.cmod.widget.SeekBar
                android:id="@+id/SBContrast"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                app:maxValue="100"
                app:minValue="-100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gamma" />

            <com.winlator.cmod.widget.SeekBar
                android:id="@+id/SBGamma"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                app:maxValue="3.0"
                app:minValue="0.5"
                app:step="0.01" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.82"
            android:background="@drawable/surface_runtime_taskmgr_background"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp"
            android:tag="theme_card preserve_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/screen_effect_dialog_hint"
                android:textSize="7.9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/surface_runtime_taskmgr_header_background"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/profile"
                android:textColor="@color/surface_runtime_taskmgr_text"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@id/SProfile"
                    style="@style/RuntimeComboBoxCompact"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@id/BTAddProfile"
                    style="@style/RuntimeListMenuButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ae_icon_add" />

                <ImageButton
                    android:id="@id/BTRemoveProfile"
                    style="@style/RuntimeListMenuButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ae_icon_remove" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBEnableFXAA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enable_fxaa" />

            <CheckBox
                android:id="@+id/CBEnableCRTShader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_crt_shader" />

            <CheckBox
                android:id="@+id/CBEnableToonShader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_toon_shader" />

            <CheckBox
                android:id="@+id/CBEnableNTSCEffect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_ntsc_effect" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
