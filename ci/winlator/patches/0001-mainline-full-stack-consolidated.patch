+    private static String buildCommandLineSnippet(String commandLine, String processLabel, String title) {
+        if (TextUtils.isEmpty(commandLine)) {
+            return "";
+        }
+
+        String normalized = trimMiddle(commandLine, 96);
+        if (TextUtils.equals(normalized, processLabel) || TextUtils.equals(normalized, title)) {
+            return "";
+        }
+        return normalized;
+    }
