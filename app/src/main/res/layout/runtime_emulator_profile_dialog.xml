<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="1dp"
    android:paddingBottom="2dp"
    android:tag="compact_runtime_dialog preserve_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="1dp"
        android:paddingEnd="1dp">

        <LinearLayout
            android:id="@+id/LLRuntimeProfileOverviewCard"
            android:layout_width="136dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/surface_runtime_taskmgr_background"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp"
            android:tag="theme_card preserve_background">

            <TextView
                android:id="@+id/TVRuntimeProfileHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/runtime_profile_dialog_hint"
                android:textSize="7.9sp" />

            <TextView
                android:id="@+id/TVRuntimeProfileModeBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/surface_runtime_taskmgr_header_background"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:textColor="@color/surface_runtime_taskmgr_text"
                android:textSize="8.4sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVRuntimeProfileModeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="4"
                android:textColor="@color/surface_runtime_taskmgr_muted"
                android:textSize="7.8sp" />

            <TextView
                android:id="@+id/TVRuntimeProfileCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/surface_runtime_taskmgr_background"
                android:lineSpacingExtra="1dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/surface_runtime_taskmgr_text"
                android:textSize="8.4sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/LLRuntimeProfileFexCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_taskmgr_background"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp"
                android:tag="theme_card preserve_background"
                android:visibility="gone">

                <TextView
                    android:id="@+id/TVRuntimeProfileFexTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/runtime_profile_fex_title"
                    android:textColor="@color/surface_runtime_taskmgr_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVRuntimeProfileFexHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/runtime_profile_fex_hint"
                    android:textColor="@color/surface_runtime_taskmgr_muted"
                    android:textSize="7.8sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/runtime_profile_fex_version"
                        android:textSize="8.1sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/SRuntimeProfileFexVersion"
                        style="@style/RuntimeComboBoxCompact"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_preset"
                        android:textSize="8.1sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/SRuntimeProfileFexPreset"
                        style="@style/RuntimeComboBoxCompact"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />

                    <ImageButton
                        android:id="@+id/BTRuntimeProfileFexAdd"
                        style="@style/RuntimeListMenuButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ae_icon_add" />

                    <ImageButton
                        android:id="@+id/BTRuntimeProfileFexEdit"
                        style="@style/RuntimeListMenuButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ae_icon_settings" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLRuntimeProfileBox64Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_runtime_taskmgr_background"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp"
                android:tag="theme_card preserve_background"
                android:visibility="gone">

                <TextView
                    android:id="@+id/TVRuntimeProfileBox64Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/runtime_profile_box64_title"
                    android:textColor="@color/surface_runtime_taskmgr_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVRuntimeProfileBox64Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/runtime_profile_box64_hint"
                    android:textColor="@color/surface_runtime_taskmgr_muted"
                    android:textSize="7.8sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/runtime_profile_box64_version"
                        android:textSize="8.1sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/SRuntimeProfileBox64Version"
                        style="@style/RuntimeComboBoxCompact"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset"
                        android:textSize="8.1sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/SRuntimeProfileBox64Preset"
                        style="@style/RuntimeComboBoxCompact"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />

                    <ImageButton
                        android:id="@+id/BTRuntimeProfileBox64Add"
                        style="@style/RuntimeListMenuButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ae_icon_add" />

                    <ImageButton
                        android:id="@+id/BTRuntimeProfileBox64Edit"
                        style="@style/RuntimeListMenuButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ae_icon_settings" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
