<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/LLContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name" />

        <EditText
            style="@style/EditText"
            android:id="@+id/ETName"
            android:inputType="textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_size" />

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:id="@+id/SScreenSize"
                    android:entries="@array/screen_size_entries"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLCustomScreenSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/width" />

                    <EditText
                        style="@style/EditText"
                        android:layout_width="78dp"
                        android:id="@+id/ETScreenWidth"
                        android:inputType="number" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/screen_size_separator" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height" />

                    <EditText
                        style="@style/EditText"
                        android:layout_width="78dp"
                        android:id="@+id/ETScreenHeight"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/graphics_driver" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/SGraphicsDriver"
                android:entries="@array/graphics_driver_entries" />

            <!-- ImageButton for configuring graphics driver version -->
            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTGraphicsDriverConfig"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@drawable/icon_settings"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/TVWrapperVersionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/installed_version"
                android:textStyle="bold"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/TVGraphicsDriverVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/colorAccent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dxwrapper"
                android:paddingTop="8dp" />

            <ImageView
                android:id="@+id/BTHelpDXWrapper"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/icon_help"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/SDXWrapper"
                android:entries="@array/dxwrapper_entries"
                android:spinnerMode="dropdown" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTDXWrapperConfig"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@drawable/icon_settings"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_driver" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SAudioDriver"
            android:entries="@array/audio_driver_entries" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/LLEmulator">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emulator_64bit" />
            <Spinner
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:id="@+id/SEmulator64"
                android:entries="@array/emulator_entries"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dll_emulator" />
            <Spinner
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:id="@+id/SEmulator"
                android:entries="@array/emulator_entries"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/midi_sound_font" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SMIDISoundFont" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lc_all" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                style="@style/AppTheme"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/ETlcall" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTShowLCALL"
                android:layout_gravity="center"
                android:src="@drawable/icon_menu" />
        </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/general" />
        </FrameLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/tab_layout_background"
            app:tabGravity="center"
            app:tabMode="auto">

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_components" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/environment_variables" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advanced" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/LLTabWinComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLWinComponentsDirectX"
                    android:tag="theme_card" />

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/directx" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLWinComponentsGeneral"
                    android:tag="theme_card" />

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/general" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTabEnvVars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.winlator.cmod.widget.EnvVarsView
                android:id="@+id/EnvVarsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <View style="@style/HorizontalLine" />

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTAddEnvVar"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTabAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/box64Frame"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_version" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SBox64Version"
                        android:layout_width="match_parent"
                        android:entries="@array/box64_version_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SBox64Preset"
                        android:layout_width="match_parent" />

                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/box64" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/fexcoreFrame"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_version" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SFEXCoreVersion"
                        android:layout_width="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_preset" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SFEXCorePreset"
                        android:layout_width="match_parent" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/fexcore_config" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/startup_selection" />

                    <Spinner
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:id="@+id/SStartupSelection"
                        android:entries="@array/startup_selection_entries" />
                </LinearLayout>

                <TextView
                    android:id="@+id/TVSystem"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/system" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SControlsProfile"
                        android:layout_width="match_parent"
                        android:spinnerMode="dropdown" />

                    <CheckBox
                        android:id="@+id/CBDisabledXInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/disable_xinput_for_shortcut" />

                    <CheckBox
                        android:id="@+id/CBTouchscreenMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/simulate_touch_screen" />

                </LinearLayout>



                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/input_controls" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/touchpad_gesture_profile" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/STouchpadGestureProfile"
                        android:layout_width="match_parent"
                        android:entries="@array/touchpad_gesture_profile_entries"
                        android:spinnerMode="dropdown" />

                    <CheckBox
                        android:id="@+id/CBTouchpadStrictGestureFsm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/touchpad_strict_gesture_fsm_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_tap_timeout_ms" />
                        <TextView
                            android:id="@+id/TVTapTimeoutMs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBTapTimeoutMs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="80"
                        android:max="500" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_tap_travel_px" />
                        <TextView
                            android:id="@+id/TVTapTravelPx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBTapTravelPx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="4"
                        android:max="24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_scroll_step_px" />
                        <TextView
                            android:id="@+id/TVScrollStepPx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBScrollStepPx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="40"
                        android:max="240" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_scroll_zone_px" />
                        <TextView
                            android:id="@+id/TVScrollZonePx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBScrollZonePx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="120"
                        android:max="700" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/touchpad_help" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">

                    <LinearLayout
                        android:id="@+id/LLDinputMapperType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/directinput_mapper_type" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SDInputType"
                            android:layout_width="match_parent"
                            android:entries="@array/dinput_mapper_type_entries" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <CheckBox
                            android:id="@+id/CBEnableXInput"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/enable_xinput_for_wine_game" />

                        <ImageView
                            android:id="@+id/BTXInputHelp"
                            style="@style/HelpButton"
                            android:layout_gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <CheckBox
                            android:id="@+id/CBEnableDInput"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_dinput_for_wine_game" />

                        <ImageView
                            android:id="@+id/BTDInputHelp"
                            style="@style/HelpButton"
                            android:layout_gravity="center" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/game_controller" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exec_arguments" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            style="@style/EditText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:id="@+id/ETExecArgs" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExtraArgsMenu"
                            android:src="@drawable/icon_menu" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/CBFullscreenStretched"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fullscreen_stretched" />

                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/system" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" >

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_preset" />

                    <Spinner
                        android:id="@+id/SUpscalerPreset"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_preset_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_backend" />

                    <Spinner
                        android:id="@+id/SUpscalerBackend"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_backend_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_effect" />

                    <Spinner
                        android:id="@+id/SUpscalerEffect"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_effect_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_scale" />

                    <Spinner
                        android:id="@+id/SUpscalerScale"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_scale_entries"
                        android:spinnerMode="dropdown" />

                    <CheckBox
                        android:id="@+id/CBEnableFrameGeneration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_enable_frame_generation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_generated_frames" />

                    <Spinner
                        android:id="@+id/SGeneratedFrames"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_generated_frames_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_fg_source" />

                    <Spinner
                        android:id="@+id/SUpscalerFgSource"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_fg_source_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_fg_output" />

                    <Spinner
                        android:id="@+id/SUpscalerFgOutput"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_fg_output_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_framegen_mode" />

                    <Spinner
                        android:id="@+id/SUpscalerFramegenMode"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/upscaler_framegen_mode_entries"
                        android:spinnerMode="dropdown" />

                    <CheckBox
                        android:id="@+id/CBUpscalerThermalGuard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_thermal_guard" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/upscaler_target_fps" />

                        <TextView
                            android:id="@+id/TVUpscalerTargetFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBUpscalerTargetFps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="144"
                        android:min="30" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/upscaler_interpolation_factor" />

                        <TextView
                            android:id="@+id/TVInterpolationFactor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBInterpolationFactor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:min="0" />

                    <CheckBox
                        android:id="@+id/CBUpscalerDebugOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_debug_overlay" />

                    <CheckBox
                        android:id="@+id/CBUpscalerDebugTearLines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_debug_tearlines" />

                    <CheckBox
                        android:id="@+id/CBUpscalerInterpolatedOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_interpolated_only" />

                    <CheckBox
                        android:id="@+id/CBEnableVulkanValidationLayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upscaler_vulkan_validation_layer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vkbasalt_sharpness_level" />

                        <TextView
                            android:id="@+id/TVSharpnessLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBSharpnessLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:min="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vkbasalt_sharpness_denoise" />

                        <TextView
                            android:id="@+id/TVSharpnessDenoise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:gravity="end" />

                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBSharpnessDenoise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:min="0" />

                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/upscaler_title" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/processor_affinity"
                android:layout_marginTop="8dp" />

            <com.winlator.cmod.widget.CPUListView
                android:id="@+id/CPUListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
