+    private ActivityManager.MemoryInfo loadDeviceMemoryInfo() {
+        ActivityManager activityManager = (ActivityManager) getSystemService(ACTIVITY_SERVICE);
+        if (activityManager == null) return null;
+        ActivityManager.MemoryInfo memoryInfo = new ActivityManager.MemoryInfo();
+        activityManager.getMemoryInfo(memoryInfo);
+        return memoryInfo;
+    }
+
+    private long bytesToMb(long value) {
+        return value <= 0L ? 0L : (value / (1024L * 1024L));
+    }
+
+    private void applyUpscalerMemoryPolicyEnv() {
+        ActivityManager.MemoryInfo memoryInfo = loadDeviceMemoryInfo();
+        long totalMemMb = memoryInfo != null ? bytesToMb(memoryInfo.totalMem) : 0L;
+        long availMemMb = memoryInfo != null ? bytesToMb(memoryInfo.availMem) : 0L;
+        boolean deviceLowMemory = memoryInfo != null && memoryInfo.lowMemory;
+
+        String effective = upscalerMemoryPolicy;
+        if (UPSCALE_MEMORY_AUTO.equals(upscalerMemoryPolicy)) {
+            if (deviceLowMemory || (availMemMb > 0L && availMemMb < 1200L) || (totalMemMb > 0L && totalMemMb < 6144L)) {
+                effective = UPSCALE_MEMORY_LOWMEM;
+            } else if (totalMemMb >= 12288L && availMemMb >= 3072L) {
+                effective = UPSCALE_MEMORY_AGGRESSIVE;
+            } else {
+                effective = UPSCALE_MEMORY_BALANCED;
+            }
+        }
+
+        switch (effective) {
+            case UPSCALE_MEMORY_AGGRESSIVE:
+                envVars.put("MESA_SHADER_CACHE_MAX_SIZE", "768M");
+                envVars.put("DXVK_STATE_CACHE", "1");
+                break;
+            case UPSCALE_MEMORY_BALANCED:
+                envVars.put("MESA_SHADER_CACHE_MAX_SIZE", "384M");
+                envVars.put("DXVK_STATE_CACHE", "1");
+                break;
+            case UPSCALE_MEMORY_LOWMEM:
+                envVars.put("MESA_SHADER_CACHE_MAX_SIZE", "128M");
+                envVars.put("DXVK_STATE_CACHE", "0");
+                break;
+            default:
+                effective = UPSCALE_MEMORY_BALANCED;
+                envVars.put("MESA_SHADER_CACHE_MAX_SIZE", "384M");
+                envVars.put("DXVK_STATE_CACHE", "1");
+                break;
+        }
+
+        String configuredVramLimit = graphicsDriverConfig != null ? graphicsDriverConfig.get("maxDeviceMemory") : "";
+        if (configuredVramLimit == null || configuredVramLimit.isEmpty()) {
+            configuredVramLimit = "0";
+        }
+        if ("0".equals(configuredVramLimit)) {
+            String autoVramLimit = UPSCALE_MEMORY_AGGRESSIVE.equals(effective) ? "4096"
+                    : (UPSCALE_MEMORY_LOWMEM.equals(effective) ? "2048" : "3072");
+            envVars.put("WRAPPER_VMEM_MAX_SIZE", autoVramLimit);
+            envVars.put("AERO_MEMORY_AUTO_VRAM_LIMIT", autoVramLimit);
+        } else {
+            envVars.put("AERO_MEMORY_AUTO_VRAM_LIMIT", "manual");
+        }
+
+        envVars.put("AERO_DEVICE_TOTAL_MEM_MB", totalMemMb);
+        envVars.put("AERO_DEVICE_AVAIL_MEM_MB", availMemMb);
+        envVars.put("AERO_DEVICE_LOW_MEMORY", deviceLowMemory ? "1" : "0");
+        envVars.put("AERO_MEMORY_POLICY_CLASS", effective);
+        envVars.put("AERO_UPSCALE_MEM_POLICY_EFFECTIVE", effective);
+        ForensicLogger.logEvent(this, "info", "UPSCALE_MEMORY_POLICY_APPLIED",
+                forensicTraceId, "graphics_driver",
+                "upscaler memory policy applied",
+                ForensicLogger.fields(
+                        "configured", upscalerMemoryPolicy,
+                        "effective", effective,
+                        "device_total_mem_mb", totalMemMb,
+                        "device_avail_mem_mb", availMemMb,
+                        "device_low_memory", deviceLowMemory ? "1" : "0",
+                        "auto_vram_limit", envVars.get("AERO_MEMORY_AUTO_VRAM_LIMIT"),
+                        "mesa_shader_cache_max_size", envVars.get("MESA_SHADER_CACHE_MAX_SIZE"),
+                        "dxvk_state_cache", envVars.get("DXVK_STATE_CACHE")
+                ));
+    }
