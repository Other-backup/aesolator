<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/surface_runtime_prefixpack_background"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:background="@drawable/surface_runtime_prefixpack_background"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="7dp"
        android:paddingBottom="6dp"
        android:tag="preserve_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_runtime_prefixpack_header_background"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="@string/prefix_pack_lane_title"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="8.7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVPrefixPackLaneInfoSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="9.2sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVPrefixPackLaneInfoState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="4"
            android:textColor="@color/surface_runtime_prefixpack_muted"
            android:textSize="8sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/surface_runtime_prefixpack_header_background"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="@string/prefix_pack_lane_contract_title"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="8.3sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/prefix_pack_lane_contract_summary"
            android:textColor="@color/surface_runtime_prefixpack_muted"
            android:textSize="7.8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/surface_runtime_prefixpack_background"
        android:orientation="vertical"
        android:padding="6dp"
        android:tag="preserve_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_runtime_prefixpack_header_background"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="@string/prefix_pack_lane_details_title"
            android:textColor="@color/surface_runtime_prefixpack_text"
            android:textSize="8.7sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:scrollbarStyle="outsideInset">

            <TextView
                android:id="@+id/TVPrefixPackLaneInfoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="0dp"
                android:textColor="@color/surface_runtime_prefixpack_text"
                android:textIsSelectable="true"
                android:textSize="8.3sp"
                android:typeface="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
