+    private List<ContentProfile> getVisibleProfilesForCurrentType() {
+        List<ContentProfile> profiles = isWineFamilySwitchType(currentContentType)
+                ? manager.getWineFamilyProfiles()
+                : manager.getProfiles(currentContentType);
+        if (profiles == null || profiles.isEmpty()) return profiles;
+
+        ArrayList<ContentProfile> filtered = new ArrayList<>();
+        for (ContentProfile profile : profiles) {
+            if (currentContentType == ContentProfile.ContentType.CONTENT_TYPE_WINE) {
+                if (profile.isWineLike()) filtered.add(profile);
+                continue;
+            }
+
+            if (currentContentType == ContentProfile.ContentType.CONTENT_TYPE_PROTON) {
+                if (profile.isProtonLike()) filtered.add(profile);
+                continue;
+            }
+
+            if (isVulkanSdkSwitchType(currentContentType)) {
+                boolean arm64 = isArm64VulkanSdkProfile(profile);
+                if (showArm64VulkanSdk && !arm64) continue;
+                if (!showArm64VulkanSdk && arm64) continue;
+                filtered.add(profile);
+                continue;
+            }
+
+            if (isArm64EcSwitchType(currentContentType)) {
+                boolean arm64ec = isArm64EcProfile(profile);
+                if (showArm64ecGraphics && !arm64ec) continue;
+                if (!showArm64ecGraphics && arm64ec) continue;
+                filtered.add(profile);
+                continue;
+            }
+
+            if (profile.isWineProtonFamily()) {
+                filtered.add(profile);
+                continue;
+            }
+
+            boolean betaLike = profile.isBetaLike();
+            if (showBeta && !betaLike) continue;
+            if (!showBeta && betaLike) continue;
+            filtered.add(profile);
+        }
+        return filtered;
+    }
