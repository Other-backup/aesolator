+        boolean scaleforceEffective = "1".equals(envVars.get("AERO_UPSCALE_SCALEFORCE_EFFECTIVE"));
+        String scaleforceReason = scaleforceEffective ? "configured" : "preset_off";
+        envVars.put("AERO_UPSCALE_SCALEFORCE_REASON", scaleforceReason);
