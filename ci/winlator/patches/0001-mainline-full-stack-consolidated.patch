+    private void updateProcessList(ArrayList<TaskRow> rows) {
+        LinearLayout container = findViewById(R.id.LLProcessList);
+        TextView emptyView = findViewById(R.id.TVEmptyText);
+        if (rows.isEmpty()) {
+            container.removeAllViews();
+            emptyView.setVisibility(View.VISIBLE);
+            return;
+        }
+
+        emptyView.setVisibility(View.GONE);
+        int childCount = container.getChildCount();
+        for (int i = 0; i < rows.size(); i++) {
+            View itemView = i < childCount
+                    ? container.getChildAt(i)
+                    : inflater.inflate(R.layout.process_info_list_item, container, false);
+            bindTaskRow(itemView, rows.get(i));
+            if (i >= childCount) {
+                container.addView(itemView);
+            }
+        }
+
+        for (int i = container.getChildCount() - 1; i >= rows.size(); i--) {
+            container.removeViewAt(i);
+        }
+    }
