<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:paddingBottom="96dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/TVGraphicsCenterHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/graphics_center_hint" />

                <TextView
                    android:id="@+id/TVGraphicsCenterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/graphics_center_status_empty"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/graphics_center_status_title" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/BTLaneTurnip"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ae_icon_turnip_lane"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:minWidth="0dp"
                        android:minHeight="72dp"
                        android:maxLines="2"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp"
                        android:textAlignment="center"
                        android:text="@string/graphics_center_lane_turnip" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/BTLaneOpenGL"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ae_icon_opengl_lane"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:minWidth="0dp"
                        android:minHeight="72dp"
                        android:maxLines="2"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp"
                        android:textAlignment="center"
                        android:text="@string/graphics_center_lane_opengl" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/TVGraphicsLaneLabel"
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/graphics_center_lanes" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/TVGraphicsDownloadsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/graphics_center_driver_feed_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/TVGraphicsFeedSourceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/contents_source_selector" />

                <Spinner
                    android:id="@+id/SGraphicsFeedSourceMode"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/TVGraphicsFeedBranchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/graphics_center_branch_selector" />

                <Spinner
                    android:id="@+id/SGraphicsFeedBranchMode"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="240dp"
                    android:layout_marginTop="10dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RVGraphicsFeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/TVGraphicsFeedEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="240dp"
                        android:gravity="center"
                        android:text="@string/graphics_center_driver_feed_empty"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/TVGraphicsDownloadsLabel"
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/graphics_center_driver_feed_title" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                style="@style/FieldSet"
                android:tag="theme_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/BTDri3Settings"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:text="@string/open_dri3_settings" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/BTOpenUpscalerSettings"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:text="@string/open_upscaler_profiles" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/RecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="72dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="vertical" />

                <Button
                    android:id="@+id/BTInstallDriver"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/install_drivers_local" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVGraphicsActionsLabel"
                style="@style/FieldSetLabel"
                android:tag="theme_badge"
                android:text="@string/graphics_center_tools_title" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
