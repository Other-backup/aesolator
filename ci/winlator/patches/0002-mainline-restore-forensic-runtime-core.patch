+                String[] parts = line.substring(colonIndex + 1).trim().split("\\s+");
+                if (parts.length < 16) {
+                    continue;
+                }
+
+                rxBytes += parseLong(parts[0], 0L);
+                txBytes += parseLong(parts[8], 0L);
+            }
