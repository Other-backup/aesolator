+ * SPDX-License-Identifier: MIT
+ */
+
+#include "pan_aemali_policy.h"
+
+#include "util/log.h"
+#include "util/os_misc.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static const char *
+aemali_first_option(const char *primary, const char *secondary,
+                    const char *tertiary)
+{
+   const char *value = os_get_option(primary);
+   if (value && value[0])
+      return value;
+
+   value = os_get_option(secondary);
+   if (value && value[0])
+      return value;
+
+   value = os_get_option(tertiary);
+   return value && value[0] ? value : NULL;
+}
+
+static bool
+aemali_matches_driver_name(const char *value)
+{
+   return value && value[0] && strstr(value, "aemali");
+}
+
+static bool
+aemali_is_truthy(const char *value)
+{
+   if (!value || !value[0])
+      return false;
+
+   return !strcmp(value, "1") ||
+          !strcmp(value, "true") ||
+          !strcmp(value, "on") ||
+          !strcmp(value, "yes") ||
+          !strcmp(value, "enabled") ||
+          !strcmp(value, "aemali");
+}
+
+bool
+pan_aemali_policy_enabled(void)
+{
+   const char *flag = os_get_option("AEMALI_OPENGL");
+   const char *driver = aemali_first_option("AEMALI_OPENGL_DRIVER",
+                                            "AERO_MESA_OPENGL_DRIVER",
+                                            "AERO_MESA_DRIVER");
+
+   return aemali_is_truthy(flag) || aemali_matches_driver_name(driver);
+}
+
+const char *
+pan_aemali_vendor_string(void)
+{
+   return pan_aemali_policy_enabled() ? "Ae.solator Mesa" : "Mesa";
+}
+
+void
+pan_aemali_build_renderer_string(char *dst, size_t dst_size,
+                                 const char *gpu_name,
+                                 unsigned core_count)
+{
+   const char *name = gpu_name && gpu_name[0] ? gpu_name : "Mali";
+
+   if (!dst || !dst_size)
+      return;
+
+   if (!pan_aemali_policy_enabled()) {
+      snprintf(dst, dst_size, "%s MC%u (Panfrost)", name, core_count);
+      return;
+   }
+
+   snprintf(dst, dst_size, "AeMali Gallium/Panfrost %s MC%u", name, core_count);
+}
+
+void
+pan_aemali_log_startup(const char *renderer, unsigned arch)
+{
+   const char *profile;
+   const char *route;
+   const char *transport;
+   const char *gallium_driver;
+   const char *render_node_required;
+   const char *render_node_present;
+
+   if (!pan_aemali_policy_enabled())
+      return;
+
+   profile = aemali_first_option("AEMALI_OPENGL_PROFILE", "AEMALI_PROFILE",
+                                 "AERO_GRAPHICS_STACK_PROFILE");
+   route = aemali_first_option("AEMALI_OPENGL_ROUTE", "AEMALI_ROUTE",
+                               "AERO_OPENGL_ROUTE_ID");
+   transport = aemali_first_option("AEMALI_OPENGL_TRANSPORT",
+                                   "AEMALI_TRANSPORT",
+                                   "AERO_OPENGL_DRIVER_TRANSPORT");
+   gallium_driver = aemali_first_option("AEMALI_OPENGL_GALLIUM_DRIVER",
+                                        "AERO_OPENGL_GALLIUM_DRIVER",
+                                        "GALLIUM_DRIVER");
+   render_node_required = aemali_first_option("AEMALI_OPENGL_RENDER_NODE_REQUIRED",
+                                              "AERO_OPENGL_REQUIRES_RENDER_NODE",
+                                              "AEMALI_RENDER_NODE_REQUIRED");
+   render_node_present = aemali_first_option("AEMALI_OPENGL_RENDER_NODE_PRESENT",
+                                             "AERO_OPENGL_RENDER_NODE_PRESENT",
+                                             "AEMALI_RENDER_NODE_PRESENT");
+
+   mesa_logi("AeMali Gallium policy: renderer=%s arch=v%u profile=%s route=%s transport=%s gallium=%s render_node_required=%s render_node_present=%s",
+             renderer ? renderer : "AeMali Gallium/Panfrost",
+             arch,
+             profile ? profile : "aemali-universal",
+             route ? route : "aemali-gallium",
+             transport ? transport : "drm-render-node-experimental",
+             gallium_driver ? gallium_driver : "panfrost",
+             render_node_required ? render_node_required : "0",
+             render_node_present ? render_node_present : "0");
+}
