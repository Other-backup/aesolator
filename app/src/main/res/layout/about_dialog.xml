<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/LLAboutHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_card_background"
            android:tag="theme_card"
            android:gravity="center_vertical"
            android:minHeight="128dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVAboutAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVAboutAppSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_app_summary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/TVWebpage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorAccent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/TVAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/IVAboutLauncherIcon"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:tag="no_theme_tint"
                android:src="@mipmap/ic_launcher" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/LLAboutCreditsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_background"
                android:tag="theme_card"
                android:orientation="vertical"
                android:paddingBottom="14dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="40dp">

                <TextView
                    android:id="@+id/TVCreditsAndThirdPartyApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVAboutCreditsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/surface_badge_background"
                android:tag="theme_badge"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/credits_and_third_party_apps"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/LLAboutRuntimeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_background"
                android:tag="theme_card"
                android:orientation="vertical"
                android:paddingBottom="14dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="40dp">

                <TextView
                    android:id="@+id/TVGlibcExpVersionFork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVAboutRuntimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/surface_badge_background"
                android:tag="theme_badge"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/glibc_exp_edition"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
