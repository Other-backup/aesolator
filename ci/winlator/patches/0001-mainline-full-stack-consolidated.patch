+        boolean screenfxEffective = "1".equals(envVars.get("AERO_UPSCALE_SCREENFX_EFFECTIVE"));
+        String screenfxReason = screenfxEffective ? "configured" : "pipeline_off";
+        envVars.put("AERO_UPSCALE_SCREENFX_REASON", screenfxReason);
