+        if (!file.isFile()) {
+            return null;
+        }
+
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(file)))) {
+            return reader.readLine();
+        } catch (IOException ignored) {
+            return null;
+        }
+    }
