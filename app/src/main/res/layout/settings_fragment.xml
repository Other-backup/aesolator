<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVBox64"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/box64" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Preset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:spinnerMode="dropdown" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:paddingTop="6dp">

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTAddBox64Preset"
                            android:tooltipText="@string/add"
                            android:src="@drawable/ae_icon_add" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTEditBox64Preset"
                            android:tooltipText="@string/edit"
                            android:src="@drawable/ae_icon_edit" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/duplicate"
                            android:id="@+id/BTDuplicateBox64Preset"
                            android:src="@drawable/ae_icon_duplicate" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/remove"
                            android:id="@+id/BTRemoveBox64Preset"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_remove" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExportBox64Preset"
                            android:tooltipText="@string/export"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_export" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/import_action"
                            android:id="@+id/BTImportBox64Preset"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_download" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVFEXCore"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/fexcore_config" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCorePreset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:spinnerMode="dropdown" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:paddingTop="6dp">

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTAddFEXCorePreset"
                            android:tooltipText="@string/add"
                            android:src="@drawable/ae_icon_add" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTEditFEXCorePreset"
                            android:tooltipText="@string/edit"
                            android:src="@drawable/ae_icon_edit" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/duplicate"
                            android:id="@+id/BTDuplicateFEXCorePreset"
                            android:src="@drawable/ae_icon_duplicate" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/remove"
                            android:id="@+id/BTRemoveFEXCorePreset"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_remove" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExportFEXCorePreset"
                            android:tooltipText="@string/export"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_export" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="@string/import_action"
                            android:id="@+id/BTImportFEXCorePreset"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_download" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVSound"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/sound" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/midi_sound_font" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/SMIDISoundFont"
                            style="@style/ComboBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/BTInstallSF"
                            style="@style/ListMenuButton"
                            android:src="@drawable/ae_icon_add" />

                        <ImageButton
                            android:id="@+id/BTRemoveSF"
                            style="@style/ListMenuButton"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ae_icon_remove" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Theme Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVTheme"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/theme" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <CheckBox
                        android:id="@+id/CBDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_dark_mode" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shortcuts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVShortcutSettings"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/path_settings" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ae_solator_path" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/TVWinlatorPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseWinlatorPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_path" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcut_export_path" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/TVShortcutExportPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseShortcutExportPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_path" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVRuntimeProfileGlobal"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/runtime_profile_global" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/runtime_profile_global" />

                    <Spinner
                        android:id="@+id/SRuntimeProfileGlobal"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </LinearLayout>


            <!-- Big Picture Mode -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVBigPictureMode"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/big_picture_mode" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">

                    <!-- SteamGridDB API Key Section -->
                    <CheckBox
                        android:id="@+id/CBEnableBigPictureMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_big_picture_mode_launch" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:paddingTop="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <CheckBox
                                    android:id="@+id/CBEnableCustomApiKey"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/steamgrid_api_key_cover_art" />

                                <ImageView
                                    android:id="@+id/BTHelpApiKey"
                                    style="@style/HelpButton"
                                    android:contentDescription="@string/help_steamgrid"
                                    android:src="@drawable/ae_icon_help" />
                            </LinearLayout>

                            <EditText
                                android:id="@+id/ETCustomApiKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/steamgrid_api_key_hint"
                                android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/FLXServerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/TVXServer"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/xserver" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cursor_speed"/>

                        <TextView
                            android:id="@+id/TVCursorSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBCursorSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="10"
                        android:max="200" />

                    <CheckBox
                        android:id="@+id/CBUseDRI3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_dri3_extension"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/TVDri3ModeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dri3_mode_title" />

                    <Spinner
                        android:id="@+id/SDri3Mode"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/dri3_mode_entries"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:id="@+id/TVDri3ModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dri3_mode_hint"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <CheckBox
                        android:id="@+id/CBDri3PresentWait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dri3_present_wait" />

                    <CheckBox
                        android:id="@+id/CBDri3ForceSwWsi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dri3_force_sw_wsi" />

                    <CheckBox
                        android:id="@+id/CBUseXR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_xr"
                        android:layout_marginTop="8dp" />

                    <!-- New Cursor Lock Checkbox -->
                    <CheckBox
                        android:id="@+id/CBCursorLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/true_mouse_control"
                        android:layout_marginTop="8dp" />

                    <!-- New Xinput Toggle Checkbox -->
                    <CheckBox
                        android:id="@+id/CBXinputToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/disable_xinput_exclusive"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/FLLegacyLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVLogs"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/logs" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <CheckBox
                        android:id="@+id/CBEnableWineDebug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_wine_debug" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/LLWineDebugChannels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp" />
                    </HorizontalScrollView>

                    <View style="@style/FieldSeparator" />

                    <CheckBox
                        android:id="@+id/CBEnableBox64Logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_box64_logs"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVExperimental"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/experimental" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/CBEnableFileProvider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/enable_file_provider" />

                        <ImageView
                            android:id="@+id/BTHelpFileProvider"
                            android:layout_gravity="center"
                            style="@style/HelpButton" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" >

                        <CheckBox
                            android:id="@+id/CBOpenWithAndroidBrowser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:text="@string/open_with_android_browser" />

                        <CheckBox
                            android:id="@+id/CBShareAndroidClipboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:text="@string/share_android_clipboard" />

                        <View style="@style/FieldSeparator" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/downloadable_contents_url" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/ETDownloadableContentsURL"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVImageFs"
                    style="@style/FieldSetLabel"
                    android:tag="theme_badge"
                    android:text="@string/imagefs" />

                <LinearLayout
                    style="@style/FieldSet"
                    android:tag="theme_card"
                    android:layout_marginTop="6dp">

                    <Button
                        style="@style/ButtonPositive"
                        android:id="@+id/BTReInstallImagefs"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/reinstall_imagefs" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:tint="@color/white"
        android:src="@drawable/ae_icon_confirm"
        android:layout_margin="16dp" />
</FrameLayout>
