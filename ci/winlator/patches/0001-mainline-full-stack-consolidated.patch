+            double sharpness = upscalerVkbasaltLevel / 100.0;
+            double denoise = upscalerVkbasaltDenoise / 100.0;
+            vkbasaltConfig = "effects=" + upscalerVkbasaltEffect + ";" +
+                    "casSharpness=" + sharpness + ";" +
+                    "dlsSharpness=" + sharpness + ";" +
+                    "dlsDenoise=" + denoise + ";" +
+                    "enableOnLaunch=True";
+            upscalerVkbasaltRuntimeReason = vkbasaltConfig.isEmpty() ? "config_empty" : "configured";
