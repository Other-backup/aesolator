<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/LLForensicPolicyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/forensic_panel_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/TVPolicyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_policy_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVForensicHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/diagnostics_hint" />

                <TextView
                    android:id="@+id/TVPolicySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/diagnostics_policy_subtitle" />

                <TextView
                    android:id="@+id/TVPolicyBadgeFreeWine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/forensic_badge_background"
                    android:text="@string/diagnostics_policy_badge_freewine"
                    android:textColor="@color/forensic_badge_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVPolicyBadgeDxvk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/forensic_badge_background"
                    android:text="@string/diagnostics_policy_badge_dxvk_vkd3d"
                    android:textColor="@color/forensic_badge_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVPolicyBadgeDgVoodoo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/forensic_badge_background"
                    android:text="@string/diagnostics_policy_badge_dgvoodoo"
                    android:textColor="@color/forensic_badge_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLForensicTogglesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/forensic_panel_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/TVTogglesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_toggles"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/CBForensicWineDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enable_wine_debug" />

                <CheckBox
                    android:id="@+id/CBForensicBox64Logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_box64_logs" />

                <CheckBox
                    android:id="@+id/CBForensicDRI3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/use_dri3_extension" />

                <TextView
                    android:id="@+id/TVForensicDri3ModeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dri3_mode_title" />

                <Spinner
                    android:id="@+id/SForensicDri3Mode"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/dri3_mode_entries"
                    android:spinnerMode="dialog" />

                <CheckBox
                    android:id="@+id/CBForensicDri3PresentWait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dri3_present_wait" />

                <CheckBox
                    android:id="@+id/CBForensicDri3ForceSwWsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dri3_force_sw_wsi" />

                <CheckBox
                    android:id="@+id/CBForensicLoaderTrace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/enable_loader_trace" />

                <CheckBox
                    android:id="@+id/CBForensicFexLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_fex_logs" />

                <CheckBox
                    android:id="@+id/CBForensicTurnipLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_turnip_logs" />

                <CheckBox
                    android:id="@+id/CBForensicDxvkLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_dxvk_logs" />

                <CheckBox
                    android:id="@+id/CBForensicVkd3dLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_vkd3d_logs" />

                <CheckBox
                    android:id="@+id/CBForensicVulkanApiDump"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_vulkan_api_dump" />

                <CheckBox
                    android:id="@+id/CBForensicVulkanLoaderDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_vulkan_loader_debug" />

                <CheckBox
                    android:id="@+id/CBForensicVulkanValidation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_vulkan_validation" />

                <CheckBox
                    android:id="@+id/CBForensicPulseLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_pulse_logs" />

                <CheckBox
                    android:id="@+id/CBForensicAlsaLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_alsa_logs" />

                <CheckBox
                    android:id="@+id/CBForensicDeviceSnapshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_device_snapshot" />

                <CheckBox
                    android:id="@+id/CBForensicNonRootCapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_nonroot_capture" />

                <CheckBox
                    android:id="@+id/CBForensicRootCapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_root_capture" />

                <Button
                    android:id="@+id/BTForensicOpenX11"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/open_dri3_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLForensicAdbCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/forensic_panel_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/TVAdbSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_adb"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVAdbCommandLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/diagnostics_adb_label" />

                <TextView
                    android:id="@+id/TVAdbCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/forensic_command_background"
                    android:paddingLeft="10dp"
                    android:paddingTop="8dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="8dp"
                    android:text="@string/diagnostics_adb_command"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    android:typeface="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/BTCopyAdbCommand"
                        style="@style/ButtonNeutral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/copy" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/BTSaveForensic"
                        style="@style/ButtonPositive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/save" />
                </LinearLayout>

                <Button
                    android:id="@+id/BTViewForensicLog"
                    style="@style/ButtonNeutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/diagnostics_view_forensic_log" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
