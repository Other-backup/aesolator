+public class TaskManagerDialog extends ContentDialog implements OnGetProcessInfoListener, WindowManager.OnWindowModificationListener {
+    private static final long PROCESS_POLL_INTERVAL_MS = 1000L;
+    private static final long PROCESS_REQUEST_TIMEOUT_MS = 2000L;
+    private static final long WINDOW_EVENT_DEBOUNCE_MS = 150L;
+    private enum ProcessScope {ALL, WINDOWS, GUEST, HOST}
+    private enum SocketFilter {ALL, ANY, TCP, UDP, UNIX}
+    private final XServerDisplayActivity activity;
+    private final LayoutInflater inflater;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+    private final LinuxTelemetrySampler telemetrySampler = new LinuxTelemetrySampler();
+    private final ArrayList<ProcessInfo> pendingProcessBatch = new ArrayList<>();
+    private final android.util.SparseArray<ProcessInfo> latestProcessMap = new android.util.SparseArray<>();
+    private LinuxTelemetrySampler.HostSample latestHostSample;
+    private ProcessScope currentProcessScope = ProcessScope.ALL;
+    private SocketFilter currentSocketFilter = SocketFilter.ALL;
+    private boolean processRequestInFlight;
+    private long processRequestStartedAtMs;
+    private boolean closed;
+    private final Runnable periodicRefreshRunnable = new Runnable() {
+        @Override
+        public void run() {
+            if (closed || !isShowing()) {
+                return;
+            }
+            requestProcessRefresh(false);
+            renderSnapshot();
+            mainHandler.postDelayed(this, PROCESS_POLL_INTERVAL_MS);
+        }
+    };
+    private final Runnable debouncedWindowRefreshRunnable = () -> {
+        if (!closed && isShowing()) {
+            renderSnapshot();
+        }
+    };
+
+    public TaskManagerDialog(XServerDisplayActivity activity) {
+        super(activity, R.layout.task_manager_dialog);
+        this.activity = activity;
+        this.inflater = LayoutInflater.from(activity);
+        setCancelable(true);
+        setTitle(R.string.task_manager);
+        setIcon(R.drawable.icon_task_manager);
+
+        TextView hintView = findViewById(R.id.TVTaskManagerHint);
+        hintView.setText(R.string.task_manager_hint);
+        bindProcessScopeControls();
+        bindSocketFilterControls();
+        TextView emptyView = findViewById(R.id.TVEmptyText);
+        emptyView.setText(R.string.task_manager_empty_hint);
+
+        Button newTaskButton = findViewById(R.id.BTCancel);
+        newTaskButton.setText(R.string.new_task);
+        newTaskButton.setOnClickListener((v) -> {
+            dismiss();
+            ContentDialog.prompt(activity, R.string.new_task, "taskmgr.exe",
+                    (command) -> activity.getWinHandler().exec(command));
+        });
+
+        Button refreshButton = findViewById(R.id.BTConfirm);
+        refreshButton.setText(R.string.refresh);
+        refreshButton.setOnClickListener((v) -> requestImmediateRefresh());
+
+        View resetButton = findViewById(R.id.BTReset);
+        resetButton.setVisibility(View.GONE);
+
+        setOnDismissListener((dialog) -> {
+            closed = true;
+            mainHandler.removeCallbacks(periodicRefreshRunnable);
+            mainHandler.removeCallbacks(debouncedWindowRefreshRunnable);
+            activity.getWinHandler().setOnGetProcessInfoListener(null);
+            activity.getXServer().windowManager.removeOnWindowModificationListener(this);
+        });
+    }
+
+    @Override
+    public void show() {
+        closed = false;
+        super.show();
+        activity.getWinHandler().setOnGetProcessInfoListener(this);
+        activity.getXServer().windowManager.addOnWindowModificationListener(this);
+        requestImmediateRefresh();
+        mainHandler.removeCallbacks(periodicRefreshRunnable);
+        mainHandler.postDelayed(periodicRefreshRunnable, PROCESS_POLL_INTERVAL_MS);
+    }
+
+    private void bindSocketFilterControls() {
+        bindSocketFilterButton(R.id.BTSocketFilterAll, SocketFilter.ALL);
+        bindSocketFilterButton(R.id.BTSocketFilterAny, SocketFilter.ANY);
+        bindSocketFilterButton(R.id.BTSocketFilterTcp, SocketFilter.TCP);
+        bindSocketFilterButton(R.id.BTSocketFilterUdp, SocketFilter.UDP);
+        bindSocketFilterButton(R.id.BTSocketFilterUnix, SocketFilter.UNIX);
+        updateSocketFilterButtons();
+    }
+
+    private void bindProcessScopeControls() {
+        bindProcessScopeButton(R.id.BTProcessScopeAll, ProcessScope.ALL);
+        bindProcessScopeButton(R.id.BTProcessScopeWindows, ProcessScope.WINDOWS);
+        bindProcessScopeButton(R.id.BTProcessScopeGuest, ProcessScope.GUEST);
+        bindProcessScopeButton(R.id.BTProcessScopeHost, ProcessScope.HOST);
+        updateProcessScopeButtons();
+    }
+
+    private void bindProcessScopeButton(int viewId, ProcessScope scope) {
+        Button button = findViewById(viewId);
+        button.setOnClickListener((v) -> {
+            if (currentProcessScope != scope) {
+                currentProcessScope = scope;
+                updateProcessScopeButtons();
+                renderSnapshot();
+            }
+        });
+    }
+
+    private void updateProcessScopeButtons() {
+        updateScopeButton(R.id.BTProcessScopeAll, currentProcessScope == ProcessScope.ALL);
+        updateScopeButton(R.id.BTProcessScopeWindows, currentProcessScope == ProcessScope.WINDOWS);
+        updateScopeButton(R.id.BTProcessScopeGuest, currentProcessScope == ProcessScope.GUEST);
+        updateScopeButton(R.id.BTProcessScopeHost, currentProcessScope == ProcessScope.HOST);
+    }
+
+    private void updateScopeButton(int viewId, boolean selected) {
