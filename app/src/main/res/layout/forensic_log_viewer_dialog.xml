<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/forensic_panel_background_dark"
    android:orientation="vertical"
    android:padding="10dp"
    android:tag="theme_card">

    <TextView
        android:id="@+id/TVForensicLogFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/forensic_badge_text_dark"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TVForensicLogStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/forensic_log_stats_text"
        android:textSize="12sp"
        android:typeface="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTForensicCopyLog"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diagnostics_forensic_log_copy" />

        <Button
            android:id="@+id/BTForensicExportLog"
            style="@style/ButtonNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/diagnostics_forensic_log_export" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/forensic_command_background_dark"
        android:padding="8dp"
        android:scrollbars="horizontal">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/TVForensicLogBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="720dp"
                android:textColor="@color/forensic_log_body_text"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace" />
        </ScrollView>
    </HorizontalScrollView>
</LinearLayout>
