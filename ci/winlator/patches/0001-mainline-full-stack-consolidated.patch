+    private android.util.SparseArray<WindowSnapshot> collectWindowSnapshots(int trackedWindowId) {
+        android.util.SparseArray<WindowSnapshot> result = new android.util.SparseArray<>();
+        XServer xServer = activity.getXServer();
+        try (XLock ignored = xServer.lock(XServer.Lockable.WINDOW_MANAGER)) {
+            Window focusedWindow = xServer.windowManager.getFocusedWindow();
+            collectWindowSnapshotsLocked(xServer, xServer.windowManager.rootWindow, focusedWindow, trackedWindowId, result);
+        }
+        return result;
+    }
+
+    private void collectWindowSnapshotsLocked(XServer xServer, Window window, Window focusedWindow,
+                                              int trackedWindowId,
+                                              android.util.SparseArray<WindowSnapshot> grouped) {
+        List<Window> children = window.getChildren();
+        for (int i = children.size() - 1; i >= 0; i--) {
+            collectWindowSnapshotsLocked(xServer, children.get(i), focusedWindow, trackedWindowId, grouped);
+        }
+
+        if (window == xServer.windowManager.rootWindow) {
+            return;
+        }
+
+        int pid = window.getProcessId();
+        if (pid <= 0) {
+            return;
+        }
+
+        boolean mapped = window.attributes.isMapped();
+        boolean looksLikeWindow = window.isInputOutput() && window.getWidth() > 8 && window.getHeight() > 8;
+        if (!mapped && window != focusedWindow) {
+            return;
+        }
+        if (!looksLikeWindow && window != focusedWindow) {
+            return;
+        }
+
+        WindowSnapshot snapshot = grouped.get(pid);
+        if (snapshot == null) {
+            snapshot = new WindowSnapshot(pid);
+            grouped.put(pid, snapshot);
+        }
+        if (window.id == trackedWindowId) {
+            snapshot.containsTrackedFrameWindow = true;
+        }
+        snapshot.totalWindows++;
+        if (mapped) {
+            snapshot.mappedWindows++;
+        }
+        if (window.isApplicationWindow()) {
+            snapshot.applicationWindows++;
+        }
+
+        boolean focused = window == focusedWindow;
+        int score = (focused ? 100 : 0)
+                + (window.isApplicationWindow() ? 50 : 0)
+                + (mapped ? 20 : 0)
+                + (window.id == trackedWindowId ? 25 : 0)
+                + (!TextUtils.isEmpty(sanitizeWindowText(window.getName())) ? 10 : 0)
+                + (!TextUtils.isEmpty(sanitizeWindowText(window.getClassName())) ? 5 : 0);
+        if (score >= snapshot.representativeScore) {
+            snapshot.representativeScore = score;
+            snapshot.focused = focused;
+            snapshot.representativeWindowId = window.id;
+            snapshot.handle = window.getHandle();
+            snapshot.windowTitle = sanitizeWindowText(window.getName());
+            snapshot.className = sanitizeWindowText(window.getClassName());
+            Bitmap icon = xServer.pixmapManager.getWindowIcon(window);
+            if (icon != null) {
+                snapshot.icon = icon;
+            }
+        } else if (focused) {
+            snapshot.focused = true;
+        }
+    }
+
+    private static String sanitizeWindowText(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.replace('\0', ' ').replaceAll("\\s+", " ").trim();
+    }
+
+    private String resolveStateLabel(ProcessInfo processInfo, LinuxTelemetrySampler.ProcessSample processSample,
+                                     WindowSnapshot windowSnapshot, boolean renderTarget) {
+        if (processSample != null && processSample.state == 'T') {
+            return activity.getString(R.string.task_manager_state_stopped);
+        }
+        if (processSample != null && processSample.state == 'Z') {
+            return activity.getString(R.string.task_manager_state_zombie);
+        }
+        if (renderTarget) {
+            return activity.getString(R.string.task_manager_state_rendering);
+        }
+        if (processSample != null && processInfo == null && windowSnapshot == null && looksLikeRuntimeHostProcess(processSample)) {
+            return activity.getString(R.string.task_manager_state_host_runtime);
+        }
+        if (windowSnapshot != null && windowSnapshot.focused) {
+            return activity.getString(R.string.task_manager_state_focused);
+        }
+        if (processInfo == null && windowSnapshot != null) {
+            return activity.getString(R.string.task_manager_state_window_only);
+        }
+        if (windowSnapshot != null && windowSnapshot.mappedWindows > 0) {
+            return activity.getString(R.string.task_manager_state_visible);
+        }
+        if (processSample != null && processSample.state == 'R') {
+            return activity.getString(R.string.task_manager_state_running);
+        }
+        if (processSample != null && (processSample.state == 'S' || processSample.state == 'D' || processSample.state == 'I')) {
+            return activity.getString(R.string.task_manager_state_sleeping);
+        }
+        if (windowSnapshot == null) {
+            return activity.getString(R.string.task_manager_state_headless);
+        }
+        return activity.getString(R.string.task_manager_state_unknown);
+    }
+
+    private String buildSourceMetric(ProcessInfo processInfo, WindowSnapshot windowSnapshot,
+                                     LinuxTelemetrySampler.ProcessSample processSample) {
+        ArrayList<String> sources = new ArrayList<>();
+        if (processInfo != null) {
+            sources.add("Guest");
+        }
+        if (windowSnapshot != null) {
+            sources.add("X11");
+        }
+        if (processSample != null && looksLikeRuntimeHostProcess(processSample)) {
+            sources.add("Host");
+        }
+        if (sources.isEmpty()) {
+            return null;
+        }
+        return TextUtils.join("+", sources);
+    }
+
+    private static boolean looksLikeRuntimeHostProcess(LinuxTelemetrySampler.ProcessSample processSample) {
+        if (processSample == null) {
+            return false;
+        }
+        String combined = (processSample.commandName + " " + processSample.commandLine).toLowerCase(Locale.ROOT);
+        return combined.contains("wine")
+                || combined.contains("proton")
+                || combined.contains(".exe")
+                || combined.contains("wineserver");
+    }
+
+    private static String describeLinuxState(char state) {
+        switch (state) {
+            case 'R':
+                return "running";
+            case 'S':
+            case 'D':
+            case 'I':
+                return "sleeping";
+            case 'T':
+                return "stopped";
+            case 'Z':
+                return "zombie";
+            default:
+                return "unknown";
+        }
+    }
+
+    private String buildWindowMetric(WindowSnapshot windowSnapshot) {
+        String visibility = windowSnapshot.focused
+                ? activity.getString(R.string.task_manager_state_focused)
+                : windowSnapshot.mappedWindows > 0
+                ? activity.getString(R.string.task_manager_state_visible)
+                : activity.getString(R.string.task_manager_state_unknown);
+        String className = trimMiddle(firstNonEmpty(windowSnapshot.className, windowSnapshot.windowTitle), 36);
+        String handle = windowSnapshot.handle != 0L ? String.format(Locale.US, "0x%X", windowSnapshot.handle) : null;
+        return joinSegments(" | ",
+                visibility,
+                windowSnapshot.mappedWindows + "/" + windowSnapshot.totalWindows + " win",
+                className,
+                handle);
+    }
